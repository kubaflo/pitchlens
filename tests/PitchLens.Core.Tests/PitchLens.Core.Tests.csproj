<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="../../src/PitchLens.App/MatchService.cs" Link="Native/MatchService.cs" />
    <Compile Include="../../src/PitchLens.App/MatchService.Guided.cs" Link="Native/MatchService.Guided.cs" />
    <Compile Include="../../src/PitchLens.App/WebContracts.cs" Link="Native/WebContracts.cs" />
    <Compile Include="../../src/PitchLens.App/PlayerPortraitCatalog.cs" Link="Native/PlayerPortraitCatalog.cs" />
    <Compile Include="../../src/PitchLens.App/PitchViewSettings.cs" Link="Native/PitchViewSettings.cs" />
    <Compile Include="../../tools/PitchLens.Generate/MotionWitnessInput.cs" Link="Fixtures/MotionWitnessInput.cs" />
    <Compile Include="../../tools/PitchLens.Generate/ActivityWitnessInput.cs" Link="Fixtures/ActivityWitnessInput.cs" />
    <Content Include="../../src/PitchLens.App/Components/MatchView.razor" Link="Components/MatchView.razor" />
    <Content Include="../../src/PitchLens.App/Components/PlayerPortrait.razor" Link="Components/PlayerPortrait.razor" />
    <Content Include="../../src/PitchLens.App/Components/ViewSettings.razor" Link="Components/ViewSettings.razor" />
    <Content Include="../../src/PitchLens.App/Components/GuidedDemoControls.razor" Link="Components/GuidedDemoControls.razor" />
    <Content Include="../../src/PitchLens.Generation/Resources/player-portraits.json" Link="PortraitAssets/portraits.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../design/player-portraits/identities.json" Link="PortraitAssets/identities.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/PitchLens.App/wwwroot/images/players/*.png" Link="PortraitAssets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/PitchLens.App/Components/MatchLenses.razor" Link="Components/MatchLenses.razor" />
    <Content Include="../../src/PitchLens.App/Components/MomentStudio.razor" Link="Components/MomentStudio.razor" />
    <Content Include="../../src/PitchLens.App/Components/EvidenceSequence.razor" Link="Components/EvidenceSequence.razor" />
    <Content Include="../../src/PitchLens.App/Components/NarrativeStory.razor" Link="Components/NarrativeStory.razor" />
    <Content Include="../../src/PitchLens.App/Components/RequestActivityView.razor" Link="Components/RequestActivityView.razor" />
    <Content Include="../../src/PitchLens.App/Components/_Imports.razor" Link="Components/_Imports.razor" />
    <Content Update="Fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\src\PitchLens.Core\PitchLens.Core.csproj" />
    <ProjectReference Include="..\..\src\PitchLens.Generation\PitchLens.Generation.csproj" />
  </ItemGroup>

</Project>