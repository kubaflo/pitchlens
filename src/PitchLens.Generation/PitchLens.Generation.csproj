<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-ios</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopilotSkipCliDownload>true</CopilotSkipCliDownload>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-ios'">17.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.22" Condition="'$(TargetFramework)' != 'net10.0-ios'" />
    <ProjectReference Include="../PitchLens.Core/PitchLens.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
    <Compile Remove="CopilotScenarioSource.cs;CopilotMomentSource.cs;CopilotExplanationRoleRunner.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources/recorded_match.json" LogicalName="PitchLens.Generation.recorded_match.json" />
    <EmbeddedResource Include="Resources/recorded_300_plan.json" LogicalName="PitchLens.Generation.recorded_300_plan.json" />
    <EmbeddedResource Include="Resources/recorded_300_commentary.json" LogicalName="PitchLens.Generation.recorded_300_commentary.json" />
    <EmbeddedResource Include="Resources/recorded_11v11_paths.json" LogicalName="PitchLens.Generation.recorded_11v11_paths.json" />
    <EmbeddedResource Include="Resources/recorded_11v11_commentary.json" LogicalName="PitchLens.Generation.recorded_11v11_commentary.json" />
    <EmbeddedResource Include="Resources/recorded_11v11_commentary_broadcast.json" LogicalName="PitchLens.Generation.recorded_11v11_commentary_broadcast.json" />
    <EmbeddedResource Include="Resources/recorded_moment_goal.json" LogicalName="PitchLens.Generation.recorded_moment_goal.json" />
    <EmbeddedResource Include="Resources/recorded_11v11_narration.json" LogicalName="PitchLens.Generation.recorded_11v11_narration.json" />
    <EmbeddedResource Include="Resources/recorded_11v11_dense_narration.json" LogicalName="PitchLens.Generation.recorded_11v11_dense_narration.json" />
    <EmbeddedResource Include="Resources/recorded_director.json" LogicalName="PitchLens.Generation.recorded_director.json" />
    <EmbeddedResource Include="Resources/player-portraits.json" LogicalName="PitchLens.Generation.player-portraits.json" />
  </ItemGroup>
</Project>
