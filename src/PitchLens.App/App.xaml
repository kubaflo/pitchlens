<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PitchLens.App.App">
    <Application.Resources>
        <Color x:Key="Accent">#37003C</Color>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#37003C, Dark=#F9F2FF}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F5F2F5, Dark=#46254F}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#37003C, Dark=#F9F2FF}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinimumHeightRequest" Value="34" />
        </Style>
        <Style TargetType="Picker">
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#37003C, Dark=#F9F2FF}" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F5F2F5, Dark=#46254F}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinimumHeightRequest" Value="36" />
        </Style>
        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#37003C, Dark=#F9F2FF}" />
            <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#725B78, Dark=#CDB3D1}" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F5F2F5, Dark=#46254F}" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="MinimumTrackColor" Value="{AppThemeBinding Light=#37003C, Dark=#00FF87}" />
            <Setter Property="MaximumTrackColor" Value="{AppThemeBinding Light=#DED0E6, Dark=#62416D}" />
            <Setter Property="ThumbColor" Value="{AppThemeBinding Light=#37003C, Dark=#00FF87}" />
        </Style>
    </Application.Resources>
</Application>
