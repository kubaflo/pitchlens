<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFrameworks>net10.0-maccatalyst;net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>PitchLens.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>PitchLens</ApplicationTitle>
    <ApplicationId>io.github.kubaflo.pitchlens</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">maccatalyst-arm64</RuntimeIdentifier>
    <CopilotSkipCliDownload Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">false</CopilotSkipCliDownload>
    <CopilotSkipCliDownload Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'maccatalyst'">true</CopilotSkipCliDownload>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PitchLensDevFlow)' == 'true' and '$(Configuration)' == 'Debug' and '$(TargetFramework)' == 'net10.0-ios' and '$(RuntimeIdentifier)' == 'iossimulator-arm64'">
    <PitchLensDevFlowEnabled>true</PitchLensDevFlowEnabled>
    <DefineConstants>$(DefineConstants);PITCHLENS_DEVFLOW</DefineConstants>
    <OutputPath>bin/Inspector/$(Configuration)/</OutputPath>
    <IntermediateOutputPath>obj/Inspector/$(Configuration)/</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(PitchLensDevFlow)' == 'true' and '$(Configuration)' == 'Debug' and '$(TargetFramework)' == 'net10.0-ios' and '$(RuntimeIdentifier)' == 'iossimulator-arm64'">
    <PackageReference Include="Microsoft.Maui.DevFlow.Agent" Version="0.1.0-preview.12.26421.1" />
    <PackageReference Include="Microsoft.Maui.DevFlow.Blazor" Version="0.1.0-preview.12.26421.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(PitchLensDevFlowEnabled)' != 'true'">
    <Content Remove="wwwroot/devflow.html" />
  </ItemGroup>
  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#37003C" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#37003C" BaseSize="128,128" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.20" />
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.22" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" />
    <ProjectReference Include="../PitchLens.Core/PitchLens.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PitchLens.Generation\PitchLens.Generation.csproj" />
  </ItemGroup>
  <!-- SDK content must also be bundle resources for native runtime lookup. -->
  <Target Name="BundleCopilotRuntime" BeforeTargets="_CollectBundleResources" DependsOnTargets="_RegisterCopilotCliForCopy"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <ItemGroup>
      <BundleResource Include="@(_CopilotRuntimeRootAsset)"
                      LogicalName="CopilotRuntime/%(RecursiveDir)%(Filename)%(Extension)" />
      <BundleResource Include="@(_CopilotRuntimePrebuildAsset)"
                      LogicalName="CopilotRuntime/prebuilds/darwin-arm64/%(RecursiveDir)%(Filename)%(Extension)" />
      <BundleResource Include="$(_CopilotCacheDir)/LICENSE.md" LogicalName="CopilotRuntime/LICENSE.md" />
    </ItemGroup>
  </Target>
</Project>
