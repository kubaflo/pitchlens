<section class="agent-workflow" aria-label="Explanation research team">
    <header><div><h3>How your explanation is made</h3><p>Three specialists work in order, sharing the same observed moment at @Report.Identity.Cutoff.ToString("0.0")s. No future events.</p></div></header>
    <ol class="agent-steps">
        @foreach(var role in Enum.GetValues<ExplanationRole>())
        {
            var stage=Report.Stages.SingleOrDefault(s=>s.Role==role.ToString());
            var state=State(stage);
            <li class="agent-step @StateClass(stage)" aria-current="@(IsActive(stage)?"step":null)">
                <div class="agent-step-top"><span class="agent-number">@((int)role+1)</span><strong>@Title(role)</strong></div>
                <span class="agent-role">@RoleName(role)</span>
                <p>@Description(role)</p>
                <div class="agent-state"><span aria-hidden="true">@(state=="Complete"?"✓":stage is null?"○":Report.Failure is not null?"!":"…")</span> @state</div>
                @if(stage is not null&&stage.Reads.Length>0){<small>@stage.Reads.Length evidence reads</small>}
                else if(stage is not null&&role==ExplanationRole.AudienceEditor){<small>Writes from the analyst's findings · No tools</small>}
            </li>
        }
    </ol>
    @if(Report.Approved){<p class="agent-result">All 3 steps completed · Review accepted this exact explanation.</p>}
    else if(Report.Failure is { } failure){<p class="agent-result agent-failed" role="status">Team stopped. No new answer was accepted. @failure</p>}
    else{<p class="agent-result">Working through the steps. The final review has not approved an answer yet.</p>}
    <p class="caption">AI review and structural checks are not a guarantee that every interpretation is true. Up to 3 responses / 12 read-only calls within 270s, plus bounded cleanup.</p>
    <details class="agent-technical">
        <summary>Technical details</summary>
        <small>Run @Report.Identity.RunId · @Report.Pipeline · Facts @Report.Identity.FactsHash</small>
        @foreach(var stage in Report.Stages)
        {
            <section><strong>@stage.Role</strong><p>@stage.Status · @stage.Model · Sessions @stage.SessionsCreated · Sends @stage.SdkSends · Responses @stage.Responses · Tool calls @stage.ToolCalls</p>
                <small>Input @stage.InputHash<br />Output @(stage.OutputHash??"Not validated yet")</small>
                @foreach(var read in stage.Reads){<p>@read.Sequence · @read.Tool · @(read.EventId??"captured index") · Cutoff @read.Cutoff.ToString("0.0")s</p>}
            </section>
        }
        @if(Report.CandidateHash is { } candidate){<small>Exact candidate @candidate</small>}
        @foreach(var check in Report.Checks){<p>@check.ClaimId · @(check.Approved?"Approved":"Rejected") · @string.Join(", ",check.EvidenceIds) · @check.Note</p>}
    </details>
</section>
@code{
    [Parameter,EditorRequired] public TeamReport Report{get;set;}=null!;
    private static string Title(ExplanationRole role)=>role switch{ExplanationRole.EvidenceAnalyst=>"Find the evidence",ExplanationRole.AudienceEditor=>"Write the explanation",_=>"Check the evidence"};
    private static string RoleName(ExplanationRole role)=>role switch{ExplanationRole.EvidenceAnalyst=>"Evidence analyst",ExplanationRole.AudienceEditor=>"Audience editor",_=>"Evidence reviewer"};
    private static string Description(ExplanationRole role)=>role switch{
        ExplanationRole.EvidenceAnalyst=>"Reads the captured events to establish what actually happened.",
        ExplanationRole.AudienceEditor=>"Receives the inspected findings, then writes for your chosen task and Fan / Analyst views.",
        _=>"Receives the final wording and independently reads every claim's cited events. Can reject the explanation."};
    private string State(AgentExecution? stage)
    {
        if(stage is null)return "Not started";
        if(stage.Status=="Validated")return "Complete";
        if(Report.Failure is not null)
            return Report.Failure.Contains("timed out",StringComparison.OrdinalIgnoreCase)||Report.Failure.Contains("deadline",StringComparison.OrdinalIgnoreCase)?"Timed out":
                Report.Failure.Contains("cancel",StringComparison.OrdinalIgnoreCase)?"Cancelled":"Rejected / stopped";
        if(stage.Responses>0)return "Validating / finishing";
        return stage.SessionsCreated==0?"Starting":"Working";
    }
    private bool IsActive(AgentExecution? stage)=>stage is not null&&stage.Status!="Validated"&&Report.Failure is null&&!Report.Approved;
    private string StateClass(AgentExecution? stage)=>stage is null?"is-queued":stage.Status=="Validated"?"is-complete":Report.Failure is not null?"is-stopped":"is-working";
}
