@implements IAsyncDisposable
@inject MatchService Session
@inject IJSRuntime JS

@if (frame is not null && Session.HasMatch)
{
    var match = frame.Match;
    var snapshot = frame.Snapshot;
    var player = match.Player(frame.SelectedId);
    var stats = snapshot.Players.Single(p => p.PlayerId == player.Id);
    <div class="matchday">
        <header class="brand-bar">
            <div class="wordmark">PitchLens <span>Matchday</span></div>
            <button class="synthetic-badge" title="Source and generation details" @onclick='() => Open("settings-dialog")'>@(Session.Mode==SessionMode.Test?"Synthetic · TEST / No AI calls":view!.Fresh?"Synthetic · Fresh SDK":"Synthetic · Recorded SDK")</button>
            <div class="actions">
                @if (Session.Generating) { <button class="button ghost" id="cancel-generation" @onclick="Session.Cancel">Cancel creation</button> }
                <button id="generate-match" class="button ghost new-match" disabled="@(Session.Mode!=SessionMode.Live || Session.Generating || Session.CheckingConnection || Session.Explainer.Busy || Session.FilmActive || Session.Director.Busy)" title="Choose teams first. No AI request until Create match." aria-label="Choose teams for a new AI match" @onclick="Generate">@(Session.Generating ? "Creating…" : "New match")</button>
            </div>
        </header>
        <div class="persistent-activities">
            <RequestActivityView Activity="Session.Explainer.Activity" Title="Sol · Explain this moment" Budget="270s response budget · Up to 6 read-only tool calls · Bounded cleanup" Cancel="Session.Explainer.Cancel" />
            <RequestActivityView Activity="Session.GenerationActivity" Title="@(Session.RequestedFixture is { } creating?$"Sol · {creating.Home.Name} v {creating.Away.Name}":"Sol · Creating your match")" Budget="15-minute total budget · Up to 3 model responses · No fallback" Cancel="Session.Cancel" />
            <RequestActivityView Activity="Session.ConnectionActivity" Title="SDK connection check · No AI request" Budget="45-second check · No generation or model usage" Cancel="Session.CancelConnection" />
            <RequestActivityView Activity="Session.Director.Activity" Title="Sol · Director's Cut" Budget="One editorial request · 270s response budget · Bounded cleanup" Cancel="Session.Director.Cancel" />
        </div>
        <header class="match-header">
            <h1 class="visually-hidden">@match.Teams[0].Name versus @match.Teams[1].Name</h1>
            <section class="fixture-score" aria-label="Fixture and score">
                <div class="team"><img src="@Crest(match.Teams[0].Id)" alt="" /><strong>@match.Teams[0].Name</strong></div>
                <strong class="score" id="match-score" aria-label="Synthetic match score"></strong>
                <div class="team away"><strong>@match.Teams[1].Name</strong><img src="@Crest(match.Teams[1].Id)" alt="" /></div>
            </section>
            <nav class="match-actions" aria-label="Match actions">
                <button id="explain-button" class="button purple" disabled="@(!Session.CanExplainCurrent)" title="@(Session.Mode==SessionMode.Test?"Matching recorded goal analysis after86s. No AI call.":"Uses Copilot usage. Explains the current observed moment.")" aria-label="@(Session.Mode==SessionMode.Test?"Recorded analysis. No AI call.":"Explain this moment. Uses Copilot usage.")" @onclick="OpenMoment">@(Session.Mode==SessionMode.Test?"Recorded analysis":"Explain this moment")</button>
                <button id="analysis-button" class="button analysis-button" disabled="@Session.FilmActive" aria-controls="analysis-dialog" @onclick='() => Open("analysis-dialog")'>
                    <span>Analysis</span>
                    @if(lensOptions.Mode!=PitchLensMode.Off)
                    {
                        <small>@lensOptions.Mode</small>
                    }
                </button>
                <button id="more-button" class="button more-button" aria-controls="more-dialog" @onclick='() => Open("more-dialog")'>More</button>
            </nav>
        </header>
        @if (error is not null) { <div class="error" role="alert">@error</div> }
        @if (evidenceNotice is not null) { <div class="request-status" role="status">@evidenceNotice</div> }
        @if (Session.MomentIntentNotice is { } momentNotice) { <div class="request-status" role="status">@momentNotice</div> }
        <MatchLenses Match="match" SelectedId="@frame.SelectedId" Options="lensOptions" View="lensView" Focus="storyFocus"
            FavoriteNotice="@favoriteNotice" FilmActive="Session.FilmActive" OptionsChanged="SetLensOptions"
            SelectedPlayer="SelectLensPlayer" FocusSelected="SetStoryFocus" Replay="ReplayConnection" />
        <ViewSettings SelectedPlayer="player" Value="Session.ViewSettings" Notice="@(viewError??Session.ViewSettingsNotice)" Changed="ApplyViewSettings" />
        <main class="matchday-stage">
            <div class="pitch-slot">
                <canvas @ref="canvas" id="pitch" tabindex="0" role="img" aria-label="Synthetic football replay. Click a shirt, or use Players for keyboard-accessible selection."></canvas>
                <div id="pitch-players" class="pitch-players" role="group" aria-label="Select a player on the pitch"></div>
                <div id="goal-banner" class="goal-banner" hidden role="status" aria-label="Goal celebration">
                    <div class="goal-card"><img id="goal-crest" alt="" /><div class="goal-copy"><span class="goal-event-tag">GOAL</span><span id="goal-team" class="goal-team"></span><strong id="goal-title"></strong><span id="goal-detail"></span></div><strong id="goal-score" class="goal-score"></strong></div>
                </div>
                <div id="goal-replay-tag" class="goal-replay-tag" hidden aria-live="off"><span></span> GOAL REPLAY <small>Back live at kickoff</small></div>
                <div id="evidence-view-tag" class="goal-replay-tag" hidden aria-live="off"></div>
                <div id="pitch-lens-tag" class="pitch-lens-tag" hidden aria-live="off"></div>
                <div id="commentary-caption" class="commentary-caption" hidden aria-label="AI commentator subtitles" aria-live="off"></div>
                <div class="film-heading" hidden="@(!Session.FilmActive)"><span>DIRECTOR'S CUT · SYNTHETIC IN-APP FILM · @(Session.Director.Current?.Fresh == true ? Session.Director.Current.Cached ? "CACHED SDK EDIT" : "FRESH SDK EDIT" : "RECORDED SDK / NOT FRESH")</span><strong id="film-position"></strong><p id="film-insight" hidden></p></div>
            </div>
            <div class="pitch-caption"><span>@(Session.FilmActive ? "Film view · Return to the paused match for player lenses." : "Click a shirt. Get the player lens.")</span><span>@(storyFocus.Kind!=StoryFocusKind.All?$"My match · {focusedHeading??"No observed story for this focus yet."}":match.Narrative is null ? frame.Explanations.LastOrDefault()?.Text ?? "Play to reveal the story." : frame.Story.LastOrDefault()?.Heading ?? "The story unfolds as you watch.")</span></div>
        </main>
        <GuidedDemoControls Step="Session.GuidedDemoStep" Navigate="TourStep" Exit="ExitTour" />
        @if (Session.FilmFrame is { } filmFrame)
        {
            <div class="film-transport"><button class="button" @onclick='() => Session.FilmCommand("restart")'>Restart film</button><button class="button purple" @onclick='() => Session.FilmCommand("toggle")'>@(Session.FilmPlaying ? "Pause film" : "Play film")</button><input aria-label="Film time in wall seconds" type="range" min="0" max="@filmFrame.Duration" step="0.1" value="@filmFrame.FilmTime" @onchange="FilmSeek" />@if (filmFrame.Holding) { <button class="button" title="Leave the film and pause the match at this scene's completed focus event." @onclick="InspectFilmScene">Inspect this scene</button> }<button class="button" @onclick='() => Session.FilmCommand("exit")'>Return to paused match</button><small>@(filmFrame.FilmTime >= filmFrame.Duration ? "Film complete. Restart or return to your paused match." : "Film clock is separate. Scene evidence unlocks at each freeze frame; player lenses require leaving film.")</small></div>
        }
        <footer class="transport">
            <fieldset class="match-controls" disabled="@Session.FilmActive">
            <button id="restart" class="button" aria-label="Replay from start" title="Replay this same match. No AI request." @onclick='() => Command("restart")'>Restart</button>
            <button id="play-pause" class="button purple play" aria-keyshortcuts="Space" @onclick="Toggle">@(snapshot.Time >= match.Duration ? "Replay match" : frame.Playing ? "Pause" : "Play")</button>
            <label class="scrub-label" for="timeline"><span class="visually-hidden">Replay</span><span class="scrub-track"><input id="timeline" type="range" min="0" max="@match.Duration" step="0.1" @onchange="TimelineChanged" aria-label="Replay time in seconds" />@foreach (var goal in snapshot.Events.Where(e => e.Kind == EventKind.Goal)) { <button class="goal-tick" style="left:@((goal.Time / match.Duration * 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%" aria-label="Watch @match.Player(goal.ActorId).Name goal at @goal.Time seconds" @onclick="() => WatchGoal(goal.Id)">●</button> }</span></label>
            <output id="replay-clock" aria-live="off" aria-label="Current replay time"></output>
            <div class="pace-control"><label class="rate-control"><span class="visually-hidden">Speed</span><select aria-label="Replay speed" value="@frame.Rate" @onchange="RateChanged"><option value="1">1x</option><option value="2">2x</option><option value="3">3x</option><option value="5">5x</option></select></label><output id="effective-speed" class="effective-speed" hidden aria-label="Temporary replay pace"></output></div>
            <button class="button cc-button" aria-label="AI commentator subtitles" aria-pressed="@(captionsEnabled ? "true" : "false")" disabled="@(match.Commentary is null)" @onclick="ToggleCaptions">CC</button>
            </fieldset>
        </footer>
        @if (Session.Generating)
        {
            <div class="request-status" role="status">Creating a synthetic match with Sol 6.1. Replay remains available.</div>
        }
        else if(Session.RecordedDemoAfterGenerationIssue && Session.PriorGenerationIssue is { } earlierIssue)
        {
            <div class="request-status" role="status">Recorded demo active · Not fresh. Earlier AI creation @(earlierIssue.State==GenerationState.Cancelled?"was cancelled":"failed"). <button class="text-button" @onclick='() => Open("generation-dialog")'>Earlier request details</button></div>
        }
        else if (Session.RequestState == GenerationState.Failed)
        {
            <div class="request-status error" role="alert">Creation failed. Previous match kept. <button class="text-button" @onclick='() => Open("generation-dialog")'>Details</button></div>
        }
        else if (Session.RequestState == GenerationState.Cancelled)
        {
            <div class="request-status" role="status">Creation cancelled. Previous match kept.</div>
        }
        <dialog id="more-dialog" class="more-dialog" aria-modal="false" aria-labelledby="more-title">
            <header class="dialog-head"><h2 id="more-title">More</h2><button class="close" data-close-popup aria-label="Close more actions">Close</button></header>
            <div class="more-actions">
                <button id="view-button" aria-controls="view-dialog" @onclick='() => Open("view-dialog")'><strong>Camera &amp; player appearance</strong><small>Change zoom, portraits, marker size and shirt numbers</small></button>
                <button id="insight-preferences-button" aria-controls="moment-dialog" @onclick='() => Open("moment-dialog")'><strong>Insight preferences</strong><small>Choose a task and focus before your next explicit explanation request</small></button>
                <button id="guided-demo-button" disabled="@(!Session.CanStartGuidedDemo)" @onclick="StartTour"><strong>Guided demo · No AI calls</strong><small>Recorded pitch, explanation, evidence and film · Requires the matching Test recording; current Live game is kept</small></button>
                <button id="players-button" disabled="@Session.FilmActive" @onclick='() => Open("roster-dialog")'><strong>Players</strong><small>Choose a shirt and open its player lens</small></button>
                <button id="story-button" disabled="@Session.FilmActive" @onclick='() => Open("story-dialog")'><strong>Match story</strong><small>Observed Fan / Analyst chapters</small></button>
                <button id="director-button" disabled="@(Session.Mode!=SessionMode.Live||!Session.CanDirect)" aria-label="Director's Cut. Uses Copilot usage." title="Uses Copilot usage. Test mode has a recorded preview in Settings." @onclick="OpenDirector"><strong>Director's Cut</strong><small>@(Session.Mode==SessionMode.Test?"Live only · Recorded preview in Settings":"Uses Copilot usage · Create an in-app film")</small></button>
                <button id="settings-button" @onclick='() => Open("settings-dialog")'><strong>Settings &amp; source</strong><small>Playback options, Test / Live mode and provenance</small></button>
            </div>
        </dialog>
        <dialog id="player-dialog" class="player-dialog" aria-modal="false" aria-labelledby="player-title">
            <header class="dialog-head"><div><span class="eyebrow">Player lens</span><span class="caption">Synthetic facts at @snapshot.Time.ToString("00.0")s</span></div><button class="close" data-close-popup aria-label="Close player popup">Close</button></header>
            <div class="dialog-body">
                <div class="player-identity"><PlayerPortrait Player="player" /><div><h2 id="player-title">@player.Name</h2><p>@Club(match, player.TeamId) · #@player.Number</p></div></div>
                <dl class="player-stats">
                    <div><dt>Passes completed</dt><dd>@stats.CompletedPasses / @stats.Passes</dd></div>
                    <div><dt>Distance</dt><dd>@stats.Distance.ToString("F1") m</dd></div>
                    <div><dt>Pass accuracy</dt><dd class="@(stats.PassAccuracy is null ? "unavailable" : "")" title="@(stats.PassAccuracy is null ? "No pass attempts yet" : null)">@(stats.PassAccuracy is double accuracy ? accuracy.ToString("P0") : "Unavailable")</dd></div>
                    <div><dt>Goals</dt><dd>@stats.Goals</dd></div>
                </dl>
                <details><summary>More player facts</summary><p>Shots: @stats.Shots · Max speed: @stats.MaxSpeed.ToString("F2") m/s</p></details>
                <p class="caption">Player facts at the replay time. Real roster name; invented match actions.</p>
            </div>
        </dialog>
        <dialog id="roster-dialog" aria-modal="false" aria-labelledby="roster-title">
            <header class="dialog-head"><div><h2 id="roster-title">Choose a player</h2><span class="caption">2026/27 roster names · Synthetic match</span></div><button class="close" data-close-popup>Close</button></header>
            <div class="dialog-body roster-list" id="roster">
                @foreach (var person in match.Players)
                {
                    <button @key="person.Id" @onclick="() => Select(person.Id)"><PlayerPortrait Player="person" Lazy="true" /><span>@person.Name<small>@Club(match, person.TeamId) · #@person.Number</small></span></button>
                }
            </div>
        </dialog>
        <dialog id="story-dialog" class="narrative-dialog" aria-labelledby="story-title">
            <header class="dialog-head"><div><span class="eyebrow">The observed arc</span><h2 id="story-title">Match story</h2><span class="caption">Only evidence observed through @snapshot.Time.ToString("00.0")s</span></div><button class="close" data-close-popup>Close</button></header>
            <div class="dialog-body">
                <div class="segments" id="mode"><button id="mode-casual" class="@(frame.Mode == ExplanationMode.Casual ? "selected" : "")" aria-pressed="@(frame.Mode == ExplanationMode.Casual ? "true" : "false")" @onclick="() => Mode(false)">Fan</button><button id="mode-analyst" class="@(frame.Mode == ExplanationMode.Analyst ? "selected" : "")" aria-pressed="@(frame.Mode == ExplanationMode.Analyst ? "true" : "false")" @onclick="() => Mode(true)">Analyst</button></div>
                @if (match.Narrative is not null)
                {
                    <NarrativeStory Match="match" Revision="frame.Revision" Cutoff="snapshot.Time" Score="snapshot.Score" Mode="frame.Mode" Fresh="view!.Fresh" Focus="storyFocus" Inspect="InspectStory" />
                }
                else
                {
                    <p class="caption">Historical scripted facts. No AI story package is attached to this scene.</p>
                    <details><summary>Observed event facts</summary>@foreach (var explanation in frame.Explanations.Reverse())
                        { <article class="story-row"><button class="evidence" @onclick="() => ReplayEvent(explanation.Time)">@explanation.Time.ToString("00.0")s</button><p>@explanation.Text</p></article> }</details>
                }
            </div>
        </dialog>
        <dialog id="moment-dialog" class="moment-dialog" aria-labelledby="moment-title">
            <header class="dialog-head"><div><span class="eyebrow">PitchLens / Evidence studio</span><h2 id="moment-title">Explain this moment</h2><span class="caption">Synthetic football · AI interpretation, not verified causal truth</span></div><button class="close" data-close-popup>Close</button></header>
            <div class="dialog-body studio-body">
                <GuidedDemoControls Step="Session.GuidedDemoStep" Context="moment" Navigate="TourStep" Exit="ExitTour" />
                <details class="insight-preferences"><summary>Insight task &amp; focus · Configure before requesting</summary>
                    <label for="insight-task">Task</label><select id="insight-task" value="@((int)Session.InsightPreferences.Task)" disabled="@(Session.Mode!=SessionMode.Live||Session.Explainer.Busy)" @onchange="InsightTaskChanged"><option value="0">Why this matters</option><option value="1">Explain the build-up</option><option value="2">Player contribution · Selects current player</option></select>
                    <label for="insight-focus">Focus</label><select id="insight-focus" value="@InsightFocusValue" disabled="@(Session.Mode!=SessionMode.Live||Session.Explainer.Busy)" @onchange="InsightFocusChanged">
                        <option value="all">Both clubs</option>@foreach(var club in match.Teams){<option value="@($"club:{club.Id}")">@club.Name</option>}
                        @foreach(var person in match.Players){<option value="@($"player:{person.Id}")">@person.Name</option>}
                    </select>
                    <p class="caption">These choices condition the next AI request, not just a local filter. Both clubs' observed events and score remain available. Player contribution selects the current player; you can choose another player focus.</p>
                    @if(Session.Mode==SessionMode.Test){<p class="caption">Test uses the recorded default briefing, not a tailored answer. No AI calls.</p>}
                    @if(insightError is not null){<p class="error" role="alert">@insightError</p>}
                    @if(Session.InsightPreferenceNotice is { } preferenceNotice){<p role="status">@preferenceNotice</p>}
                    @if(Session.Mode==SessionMode.Live){<button id="tailor-explain-button" class="button" disabled="@(!Session.CanExplainCurrent||Session.Explainer.Busy)" title="Uses Copilot usage unless this exact request is already cached. No automatic retry." @onclick="OpenMoment">Explain with these preferences · Uses Copilot usage</button>}
                </details>
                <RequestActivityView Activity="Session.Explainer.Activity" Title="Sol · Moment analysis" Budget="270s response budget · Up to 6 read-only tool calls · Bounded cleanup" Cancel="Session.Explainer.Cancel" />
                @if (Session.ExplanationSnapshot is { } captured)
                {
                    var focus = captured.Resolve(captured.FocusId);
                    <div class="studio-captured"><strong>Captured @captured.Cutoff.ToString("0.0")s</strong><span>@focus.Kind · @focus.Actor · event @focus.Time.ToString("0.0")s</span></div>
                }
                @if (Session.MomentIntentNotice is { } intentNotice) { <p role="status">@intentNotice</p> }
                @if (Session.Explainer.VisibleAt(frame.Revision, snapshot.Time) is { } explained)
                {
                    <MomentStudio Result="explained" Pending="Session.Explainer.Busy" Earlier="@(Session.Explainer.Activity.Snapshot.Stage is RequestStage.Failed or RequestStage.Cancelled || explained.Evidence.Hash != Session.ExplanationSnapshot?.Hash)" Inspect="id => InspectEvidence(explained.Evidence, id)" />
                }
                else if (Session.Explainer.Current is { } hiddenExplanation)
                { <p class="caption">Saved analysis is hidden before its captured cutoff of @hiddenExplanation.Evidence.Cutoff.ToString("0.0")s. Seek forward to that time to view it again.</p> }
                @if (Session.Mode==SessionMode.Live && !Session.Explainer.Busy && Session.Explainer.Activity.Snapshot.Stage is RequestStage.Failed or RequestStage.Cancelled)
                { <button class="button" disabled="@(!Session.CanExplainCurrent)" title="Uses Copilot usage. One explicit retry of the current captured moment." @onclick="RetryMoment">Retry current moment</button> }
                <span class="caption" role="status">@Session.Explainer.Status</span>
                <details class="caption"><summary>Request limits & data handling</summary><p>Exact @CopilotScenarioSource.Model, up to six read-only evidence calls, one response for both modes. Response budget 270 seconds plus bounded SDK cleanup. No automatic retries or fallback. Raw responses are not automatically logged. Invalid output keeps the earlier answer.</p></details>
            </div>
        </dialog>
        <dialog id="director-dialog" aria-labelledby="director-title">
            <header class="dialog-head"><div><span class="eyebrow">AI editorial / Observed footage</span><h2 id="director-title">Director's Cut</h2></div><button class="close" data-close-popup>Close</button></header>
            <div class="dialog-body">
                <RequestActivityView Activity="Session.Director.Activity" Title="Sol is directing your film" Budget="One request · 270s response budget · No automatic retries" Cancel="Session.Director.Cancel" />
                <p>@Session.DirectorNotice</p><p role="status">@Session.Director.Status</p>
                @if (Session.Director.Current is { } directed)
                {
                    <span class="source-pill">@(directed.Fresh ? directed.Cached ? "Cached SDK edit / Exact snapshot" : "Fresh SDK edit" : "Recorded SDK edit / Not fresh")</span>
                    @if (Session.Director.Busy || Session.Director.Activity.Snapshot.Stage is RequestStage.Failed or RequestStage.Cancelled)
                    { <strong>Earlier valid film · latest request has not replaced it</strong> }
                    <p>@FilmTimeline.Duration(directed.Plan).ToString("0.0")s film · @directed.Plan.Scenes.Length scenes · Observed through @directed.Evidence.Cutoff.ToString("0.0")s</p>
                    <button class="button mint" disabled="@(Session.Director.Busy || Session.Explainer.Busy || Session.Generating || Session.CheckingConnection)" @onclick="WatchFilm">Watch in-app film</button>
                }
                @if (Session.Mode==SessionMode.Live && !Session.Director.Busy && Session.Director.Activity.Snapshot.Stage is RequestStage.Failed or RequestStage.Cancelled)
                { <button class="button" @onclick="RetryDirector" title="Uses Copilot usage">Retry editorial request</button> }
                <p class="caption">Not MP4, audio or real video. Actual synthetic match positions; AI selects clips and explains observed evidence. Main match remains paused and unchanged. Exit returns to its saved position/speed/selection.</p>
            </div>
        </dialog>
        <dialog id="generation-dialog" aria-labelledby="generation-title">
            <header class="dialog-head"><div><span class="eyebrow">Copilot SDK</span><h2 id="generation-title">Create a new match.</h2><span class="caption">A real generation request, not a scripted preview.</span></div><button class="close" data-close-popup>Close</button></header>
            <div class="dialog-body">
                <RequestActivityView Activity="Session.GenerationActivity" Title="Sol · Creating your match" Budget="15-minute total budget · Paths, optional correction, commentary" Cancel="Session.Cancel" />
                <p>@(Session.RequestedFixture is { } fixture?$"{fixture.Home.Name} v {fixture.Away.Name}":"Selected Premier League clubs") · Five minutes (300 seconds) · Synthetic 11v11. All 22 player paths and events authored by AI.</p>
                <p>Only GPT-6.1 Sol (@CopilotScenarioSource.Model), using normal local Copilot login. Paths/events, at most one shared AI correction for measured shape/speed/velocity defects OR unsupported phase labels, then grounded subtitles: at most three model responses, bounded to fifteen minutes. Path correction keeps events and phases immutable; phase correction cannot change events or paths. May consume usage. No model fallback.</p>
                <div class="actions"><button class="button purple" @onclick="Generate" disabled="@(Session.Mode!=SessionMode.Live||Session.Generating || Session.CheckingConnection || Session.Explainer.Busy)">Choose teams for a new match</button>@if (Session.Generating) { <button class="button" @onclick="Session.Cancel">Cancel creation</button> }</div>
                <p id="generation-status" role="@(Session.RequestState == GenerationState.Failed && !Session.RecordedDemoAfterGenerationIssue ? "alert" : "status")">@Session.Status</p>
                @if(Session.PriorGenerationIssue is { } priorIssue)
                {
                    <details id="earlier-generation-issue"><summary>Earlier generation @(priorIssue.State==GenerationState.Cancelled?"cancelled":"failed") · Recorded demo was explicitly selected</summary><p>@priorIssue.Message</p><p class="caption">Elapsed @TimeSpan.FromSeconds(priorIssue.ElapsedSeconds).ToString(@"m\:ss"). This is a prior request outcome, not the current match's source or an active request.</p></details>
                }
                <p class="caption">Closing this popup does not cancel creation. Cancel is also available in the main brand bar. Invalid output or cancellation keeps the last valid match.</p>
            </div>
        </dialog>
        <dialog id="fixture-dialog" class="fixture-dialog" aria-modal="false" aria-labelledby="fixture-picker-title">
            <header class="dialog-head"><span class="caption">Live fixture · Replay continues until Create</span><button class="close" data-close-popup>Close</button></header>
            <div class="dialog-body"><FixturePicker Value="Session.FixtureChoice" Busy="Session.Generating" Error="@fixtureError" Changed="SetFixtureChoice" Create="CreateFixture" Cancel="CancelFixture" /></div>
        </dialog>
        <dialog id="settings-dialog" aria-labelledby="settings-title">
            <header class="dialog-head"><div><h2 id="settings-title">Replay settings</h2><span class="caption">Camera, playback and source</span></div><button class="close" data-close-popup>Close</button></header>
            <div class="dialog-body">
                <section class="camera-entry"><h3>Camera &amp; player appearance</h3><p>Change zoom, portraits, marker size and shirt numbers.</p><button id="settings-camera-button" class="button purple" aria-controls="view-dialog" @onclick='() => Open("view-dialog")'>Open camera &amp; player appearance</button></section>
                <section><h3>Guided demo · No AI calls</h3><p>Recorded pitch, Fan / Analyst explanation, canonical evidence and 58-second film. Requires Test mode with the matching recording. Never replaces a current Live game.</p><button id="settings-guided-demo" class="button" disabled="@(!Session.CanStartGuidedDemo)" @onclick="StartTour">Start recorded guided demo</button></section>
                <RequestActivityView Activity="Session.ConnectionActivity" Title="SDK connection check · No AI request" Budget="45-second check · No generation or model usage" Cancel="Session.CancelConnection" />
                <section><h3>@Session.Mode mode</h3><p>Test blocks all SDK requests. Switching modes preserves your current game; generating a new Live match is an explicit separate action. Exit the guided demo before changing modes.</p><div class="actions"><button class="button" disabled="@(Session.GuidedDemoActive||Session.Generating||Session.Explainer.Busy||Session.Director.Busy||Session.CheckingConnection)" @onclick="UseTest">Use Test mode · No AI calls</button><button class="button" disabled="@(Session.GuidedDemoActive||Session.Generating||Session.Explainer.Busy||Session.Director.Busy||Session.CheckingConnection)" @onclick="UseLive">Use Live mode · Keep current match</button></div></section>
                <section id="scenario-provenance"><h3>@(view!.Origin == ScenarioOrigin.DeterministicDemo ? "Authored five-minute demo" : view.Fresh ? "New SDK-generated match" : "Recorded SDK example")</h3><p>Source model: @(view.Model ?? "None — authored locally"). @(view.Fresh ? "Generated in this session." : "Not a fresh request.")</p><p>All actions are synthetic. Real 2026/27 roster names; no real match result or athlete performance claim.</p></section>
                <details><summary>Official player photos · Offline</summary><p>@PlayerPortraitCatalog.Entries.Count(p=>p.ImagePath is not null) verified portraits for @PlayerPortraitCatalog.Entries.Count selected identities. Missing or failed images show a shirt-number fallback. Premier League/rightsholder images used with user-confirmed permission for this non-commercial project; no endorsement or open-source image license is claimed. Portraits do not describe real match performance.</p></details>
                <p>@(match.Commentary is { } commentary ? $"AI commentator subtitles: {commentary.Model}, {commentary.Cues.Count} timed cues for this match. {(view.Fresh ? "Generated with this match." : "Recorded generation, not a fresh request.")} {(match.Narrative is null ? "Historical story facts are scripted." : $"AI story: {match.Narrative.Chapters.Count} evidence-bound Fan/Analyst chapters from the same response.")}" : "AI narration unavailable; historical event facts are scripted.")</p>
                @if(match.Commentary is { Contract:2 } denseTrack)
                {
                    var coverage=CaptionSchedule.Measure(denseTrack.Cues.Select(c=>new CaptionSlot(c.EventId,c.Start,c.End)),match.Duration);
                    <p class="caption">Dense caption contract 2 · @coverage.Seconds.ToString("0.#")s / @coverage.Fraction.ToString("P1") covered · Maximum observed interior gap @coverage.MaximumInteriorGap.ToString("0.#")s. @(coverage.MaximumInteriorGap>4?"Sparse source events leave an unavoidable gap above 4s; no stale filler is shown.":"Every interior gap is at most 4s.")</p>
                }
                @if (match.Players.Count == 22)
                {
                    <p>All 22 explicit player trajectories and events were authored by Sol. The viewer only interpolates those knots; ball motion follows validated possession and events. No procedural support-path or formation solver. Illustrative 11v11 selection, not an actual starting XI.</p>
                }
                <div class="actions"><button class="button" @onclick="() => Seek(-5)">−5 seconds</button><button class="button" @onclick="() => Seek(5)">+5 seconds</button></div>
                <button class="button" aria-pressed="@(frame.HighlightsEnabled ? "true" : "false")" @onclick="ToggleGoalReplays">Goal highlights: @(frame.HighlightsEnabled ? "On" : "Off")</button>
                <p class="caption">Highlights use a contextual 2D camera and readable 1x buildup/finish/replay pace, then restore your selected speed at kickoff. The native clock owns both rates. Reduced motion keeps the tactical camera and suppresses extra effects.</p>
                <p>Space plays or pauses; Left/Right seek one second outside form controls. Player lens and roster preserve playback. Story, settings and creation pause replay.</p>
                <details><summary>Recorded Director's Cut demo · No AI call</summary><p>A real Sol-authored58second edit of the startup recording. Requires that matching scene observed through300s (seek to the end to preview). Clearly labelled Recorded SDK / Not fresh; the main Director action still requests a new edit.</p><button class="button" disabled="@(Session.Director.Busy || Session.Explainer.Busy || Session.Generating || Session.CheckingConnection || Session.FilmActive || !DirectorRecording.Available(match, frame.Revision, snapshot.Time))" @onclick="PreviewDirector">Watch recorded film · No AI call</button></details>
                <details><summary>Advanced generation setup</summary><p>New requests use @CopilotScenarioSource.Model. Normal Copilot login and model access are required.</p><label for="cli">Compatible runtime override</label><input id="cli" placeholder="Bundled runtime (leave blank)" @bind="Session.CliOverride" disabled="@(Session.Mode!=SessionMode.Live||Session.Generating || Session.CheckingConnection || Session.Explainer.Busy)" /><button class="button" @onclick="Session.CheckConnectionAsync" disabled="@(Session.Mode!=SessionMode.Live||Session.Generating || Session.CheckingConnection || Session.Explainer.Busy)">Check SDK connection (no generation)</button><p role="status">@Session.ConnectionStatus</p></details>
            </div>
        </dialog>
    </div>
}
else
{
    <div class="matchday match-preparing">
        <header class="brand-bar"><div class="wordmark">PitchLens <span>Matchday</span></div><span>@(Session.Mode==SessionMode.Unchosen?"Choose a mode · No AI request yet":"Live · Fresh AI match")</span></header>
        <main class="new-session-pitch">
            <div class="setup-card">
            @if(Session.Mode==SessionMode.Unchosen)
            {
                <h1>Your matchday starts here</h1><p class="setup-description">Play a recorded match, take the guided tour, or choose teams for a new AI match.</p>
                <div class="setup-mode-actions"><button id="first-live-choice" class="button purple" title="Choose teams first. No AI request until Create match." @onclick="StartLive">Choose teams · AI match</button><button class="button" @onclick="StartTest">Test mode · Instant · No AI calls</button><button id="first-guided-demo" class="text-button" @onclick="StartTour">Guided demo · No AI calls · Starts Test mode</button></div>
            }
            else if(Session.Generating)
            {
                <h1>Your match is taking shape</h1>
                @if(Session.RequestedFixture is { } pendingFixture){<h2 class="setup-fixture">@pendingFixture.Home.Name <span class="fixture-versus">v</span> @pendingFixture.Away.Name</h2>}
                <RequestActivityView Activity="Session.GenerationActivity" Title="Creating your AI match" Budget="15-minute limit · Up to 3 responses" Cancel="Session.Cancel" />
            }
            else
            {
                @if(Session.Mode==SessionMode.Live&&Session.FixturePickerOpen)
                {<FixturePicker Value="Session.FixtureChoice" Startup="true" Error="@fixtureError" Changed="SetFixtureChoice" Create="CreateFixture" Cancel="CancelFixture" />}
                else{<h1>Choose your teams</h1><p class="setup-description">Choose your clubs before creating a five-minute AI match.</p><button id="choose-startup-teams" class="button purple" @onclick="Generate">Choose teams</button>}
                @if(Session.RequestState==GenerationState.Failed){<p class="error" role="alert">@Session.Status</p>}
                else if(Session.RequestState==GenerationState.Cancelled){<p class="caption" role="status">@Session.Status</p>}
                <button id="startup-test-demo" class="text-button setup-demo" @onclick="StartTest">Try recorded demo · No AI calls</button>
            }
            </div>
        </main>
    </div>
}

@code {
    private PresentationFrame? frame;
    private NativeView? view;
    private ElementReference canvas;
    private IJSObjectReference? module;
    private Task? rendererInitialization;
    private bool rendererReady;
    private DotNetObjectReference<MatchView>? reference;
    private readonly CancellationTokenSource lifetime = new();
    private Task? ticker;
    private bool disposed;
    private bool startupRequested;
    private string? error;
    private string? evidenceNotice;
    private FilmPlan? loadedFilm;
    private double lastFilmTime = double.NaN;
    private bool lastFilmPlaying;
    private long loadedRevision;
    private PopupRequest? pendingPopup;
    private bool captionsEnabled = true;
    private PitchViewSettings? loadedViewSettings;
    private string? viewError;
    private string? fixtureError;
    private string? insightError;
    private string InsightFocusValue=>Session.InsightPreferences.Scope switch {InsightScope.Club=>$"club:{Session.InsightPreferences.SubjectId}",InsightScope.Player=>$"player:{Session.InsightPreferences.SubjectId}",_=>"all"};
    private void InsightTaskChanged(ChangeEventArgs e)
    {
        try
        {
            if(!int.TryParse(e.Value?.ToString(),out var value)||!Enum.IsDefined((InsightTask)value))throw new ArgumentException("Choose a known insight task.");
            var task=(InsightTask)value;var preferences=Session.InsightPreferences with{Task=task};
            if(task==InsightTask.PlayerContribution)preferences=preferences with{Scope=InsightScope.Player,SubjectId=frame!.SelectedId};
            Session.SetInsightPreferences(preferences);insightError=null;
        }
        catch(Exception error) when(error is ArgumentException or InvalidOperationException){insightError=error.Message;}
    }
    private void InsightFocusChanged(ChangeEventArgs e)
    {
        try
        {
            var value=e.Value?.ToString();var scope=value=="all"?InsightScope.All:value?.StartsWith("club:",StringComparison.Ordinal)==true?InsightScope.Club:
                value?.StartsWith("player:",StringComparison.Ordinal)==true?InsightScope.Player:throw new ArgumentException("Choose a known match focus.");
            Session.SetInsightPreferences(Session.InsightPreferences with{Scope=scope,SubjectId=scope==InsightScope.All?null:value![(value.IndexOf(':')+1)..]});insightError=null;
        }
        catch(Exception error) when(error is ArgumentException or InvalidOperationException){insightError=error.Message;}
    }
    private async Task StartTour()
    {
        try{Session.StartGuidedDemo();evidenceNotice=null;if(module is not null){await module.InvokeVoidAsync("closePopup","settings-dialog");await module.InvokeVoidAsync("closePopup","more-dialog");}}
        catch(InvalidOperationException error){evidenceNotice=error.Message;}
    }
    private async Task TourStep(int step)
    {
        try
        {
            Session.SetGuidedDemoStep(step);
            if(step==1)Open("moment-dialog");
            else if(step==2){var captured=Session.Explainer.Current!.Evidence;await InspectEvidence(captured,captured.FocusId);}
            else if(module is not null)await module.InvokeVoidAsync("closePopup","moment-dialog");
        }
        catch(InvalidOperationException error){evidenceNotice=error.Message;}
    }
    private async Task ExitTour()
    {Session.ExitGuidedDemo();if(module is not null)await module.InvokeVoidAsync("closePopup","moment-dialog");}
    private LensOptions lensOptions=new();
    private StoryFocus storyFocus=new();
    private PitchLensView? lensView;
    private string? favoriteNotice;
    private string? focusedHeading;
    private long lensRevision;
    private sealed record PopupRequest(string Id,long Revision);
    private static string Crest(string id) => FixtureCatalog.Clubs.Single(t=>t.Id==id).Crest!;
    private static string Club(Match match, string id) => match.Teams.Single(t => t.Id == id).Name;
    protected override void OnInitialized()
    {
        view = Session.Sample(true);
        frame = view?.Frame;
        UpdateLenses();
        Session.Changed += Changed;
    }
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (disposed || error is not null) return;
        try
        {
            if (!startupRequested)
            {
                startupRequested = true;
                await Session.StartSessionAsync();
                if (!disposed) StateHasChanged();
                return;
            }
            if (Session.HasMatch && !rendererReady)
            {
                rendererInitialization ??= InitializeRendererAsync();
                await rendererInitialization;
            }
            if (!disposed && module is not null && pendingPopup is { } popup)
            {
                pendingPopup = null;
                if(popup.Id!="analysis-dialog"||popup.Revision==frame?.Revision&&!Session.FilmActive)
                    await module.InvokeVoidAsync("openPopup", popup.Id, frame?.SelectedId);
            }
        }
        catch (JSException e) { if (!disposed) { error = $"Match interface failed: {e.Message}"; Session.Command("pause"); StateHasChanged(); } }
    }
    private async Task InitializeRendererAsync()
    {
        var imported = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pitch.mjs");
        if (disposed) { await imported.DisposeAsync(); return; }
        module = imported;
        reference = DotNetObjectReference.Create(this);
        await module.InvokeVoidAsync("initialize", canvas, reference);
        if (disposed) return;
        rendererReady = true;
        await Refresh(true);
        await module.InvokeVoidAsync("setCaptionsEnabled", captionsEnabled);
        ticker ??= Tick();
    }
    private void Changed() { if (!disposed) _ = InvokeAsync(() => Refresh(true)); }
    private async Task Tick()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(250));
            while (await timer.WaitForNextTickAsync(lifetime.Token))
                if (!disposed && Session.Active && (frame?.Playing == true || FilmNeedsRefresh())) await InvokeAsync(() => Refresh(false));
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
    }
    private async Task Refresh(bool force)
    {
        if (disposed || error is not null) return;
        var next = Session.Sample(force);
        if (next is null) return;
        view = next;
        var current = next.Frame;
        frame = current;
        UpdateLenses();
        var currentLens=lensView;
        if (Session.FilmFrame is { } sampledFilm) { lastFilmTime = sampledFilm.FilmTime; lastFilmPlaying = Session.FilmPlaying; }
        else { lastFilmTime = double.NaN; lastFilmPlaying = false; }
        try
        {
            if (module is not null && rendererReady && Session.HasMatch)
            {
                if (loadedRevision != current.Revision)
                {
                    loadedRevision = current.Revision;
                    await module.InvokeVoidAsync("loadScenario", WebContracts.Scenario(current.Match, current.Revision));
                }
                if(loadedViewSettings!=Session.ViewSettings)
                {
                    loadedViewSettings=Session.ViewSettings;
                    await module.InvokeVoidAsync("setViewSettings",PitchViewSettings.Serialize(loadedViewSettings));
                }
                await module.InvokeVoidAsync("setClock", WebContracts.Clock(current),
                    currentLens is null?null:JsonSerializer.Serialize(currentLens,WebJsonContext.Default.PitchLensView));
                if (Session.FilmFrame is { } filmFrame && Session.Director.Current is { } directed)
                {
                    if (!ReferenceEquals(loadedFilm, directed.Plan))
                    { await module.InvokeVoidAsync("loadFilm", JsonSerializer.Serialize(directed.Plan, WebJsonContext.Default.FilmPlan)); loadedFilm = directed.Plan; }
                    await module.InvokeVoidAsync("setFilmClock", filmFrame.FilmTime, Session.FilmPlaying, current.Sequence, current.Revision);
                }
                else if (loadedFilm is not null) { loadedFilm = null; await module.InvokeVoidAsync("loadFilm", (string?)null); }
            }
            StateHasChanged();
        }
        catch (JSDisconnectedException) { lifetime.Cancel(); }
        catch (JSException e) { error = $"Pitch interop failed: {e.Message}"; Session.Command("pause"); StateHasChanged(); }
    }
    private void Open(string id)
    {
        if (id is not ("player-dialog" or "roster-dialog" or "analysis-dialog" or "more-dialog" or "view-dialog" or "fixture-dialog")) Session.Command("pause");
        pendingPopup = new(id,frame?.Revision??0);
        StateHasChanged();
    }
    private void UpdateLenses()
    {
        if(frame is null)return;
        if(lensRevision!=frame.Revision)
        {
            lensRevision=frame.Revision;
            lensOptions=lensOptions with{EdgeId=null,Cell=null};
            if(!frame.Match.Teams.Any(t=>t.Id==lensOptions.ClubId))lensOptions=lensOptions with{ClubId=frame.Match.Teams[0].Id};
            if(!PitchLens.Core.MatchLenses.FocusAvailable(frame.Match,storyFocus))
            {
                favoriteNotice="Your previous favorite is not in this match. Showing all observed stories.";
                storyFocus=new();
            }
        }
        focusedHeading=PitchLens.Core.MatchLenses.Story(frame.Match,frame.Snapshot.Time,storyFocus).LastOrDefault()?.Chapter.Heading;
        if(Session.FilmActive||lensOptions.Mode==PitchLensMode.Off){lensView=null;return;}
        var window=ObservedWindow.Capture(frame.Match,frame.Revision,frame.Snapshot.Time,lensOptions.Range);
        lensView=lensOptions.Mode==PitchLensMode.Connections?
            PitchLens.Core.MatchLenses.Connections(frame.Match,window,lensOptions.ClubId??frame.Match.Teams[0].Id,lensOptions.EdgeId):
            PitchLens.Core.MatchLenses.Movement(frame.Match,window,frame.SelectedId,lensOptions.Cell);
        if(lensOptions.EdgeId!=lensView.SelectedEdgeId)lensOptions=lensOptions with{EdgeId=lensView.SelectedEdgeId};
    }
    private Task ApplyViewSettings(PitchViewSettings settings)
    {
        try{Session.SetViewSettings(settings);viewError=null;}
        catch(Exception e) when(e is ArgumentException or IOException or UnauthorizedAccessException or InvalidOperationException)
        {viewError=$"View settings unchanged: {e.Message}";}
        StateHasChanged();return Task.CompletedTask;
    }
    private async Task SetLensOptions(LensOptions options)
    {
        if(Session.FilmActive)return;
        if(!Enum.IsDefined(options.Mode)||!Enum.IsDefined(options.Range)||frame is null||
            options.ClubId is not null&&!frame.Match.Teams.Any(t=>t.Id==options.ClubId))
            throw new ArgumentException("Lens selection must belong to this match.");
        lensOptions=options;await Refresh(true);
    }
    private async Task SelectLensPlayer(string id)
    {
        if(Session.FilmActive)return;
        Session.Command("select",id:id);
        await Refresh(true);
    }
    private async Task SetStoryFocus(StoryFocus focus)
    {
        if(frame is null||Session.FilmActive)return;
        if(!PitchLens.Core.MatchLenses.FocusAvailable(frame.Match,focus))throw new ArgumentException("Favorite is not in this match.");
        storyFocus=focus;favoriteNotice=null;
        if(focus.Kind==StoryFocusKind.Player)
        {
            Session.Command("select",id:focus.Id);
            lensOptions=lensOptions with{ClubId=frame.Match.Player(focus.Id!).TeamId,EdgeId=null};
        }
        else if(focus.Kind==StoryFocusKind.Club)lensOptions=lensOptions with{ClubId=focus.Id,EdgeId=null};
        await Refresh(true);
    }
    private async Task ReplayConnection((PitchLensView View,string EdgeId) request)
    {
        try
        {
            var captured=Session.ConnectionEvidence(request.View,request.EdgeId);
            if(module is not null)await module.InvokeVoidAsync("closePopup","analysis-dialog");
            await InspectEvidence(captured,captured.FocusId);
        }
        catch(InvalidOperationException e){evidenceNotice=e.Message;StateHasChanged();}
    }
    private void Command(string command) => Session.Command(command);
    private void Toggle() => Command("toggle");
    private void RateChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var rate) && Playback.IsSupportedRate(rate))
            Session.Command("rate", rate);
        else error = "Invalid replay speed.";
    }
    private async Task ToggleCaptions()
    {
        captionsEnabled = !captionsEnabled;
        try { if (module is not null) await module.InvokeVoidAsync("setCaptionsEnabled", captionsEnabled); }
        catch (JSDisconnectedException) { lifetime.Cancel(); }
        catch (JSException e) { error = $"Subtitle control failed: {e.Message}"; Session.Command("pause"); }
    }
    private void ToggleGoalReplays() => Session.Command("highlights", frame?.HighlightsEnabled == true ? 0 : 1);
    private void WatchGoal(string id) => Session.Command("watch-goal", id: id);
    private async Task OpenMoment()
    {
        if(Session.Mode==SessionMode.Test){Session.TestExplain();Open("moment-dialog");return;}
        if (!Session.CanExplainCurrent) { await Session.ExplainCurrentMomentAsync(); return; }
        Open("moment-dialog");
        await Session.ExplainCurrentMomentAsync();
    }
    private Task RetryMoment() => Session.ExplainCurrentMomentAsync(retry: true);
    private Task StartTest()=>Session.ChooseModeAsync(SessionMode.Test);
    private Task StartLive()=>Session.ChooseModeAsync(SessionMode.Live);
    private Task UseTest()=>Session.ChooseModeAsync(SessionMode.Test,false);
    private Task UseLive()=>Session.ChooseModeAsync(SessionMode.Live,false);
    private async Task OpenDirector()
    {
        if(Session.Mode!=SessionMode.Live){Open("settings-dialog");return;}
        var allowed = Session.CanDirect;
        Open("director-dialog");
        await Session.DirectCurrentAsync();
        if (allowed && !Session.FilmActive && !Session.Director.Busy && Session.Director.Current is not null && Session.Director.Activity.Snapshot.Stage == RequestStage.Complete)
            await WatchFilm();
    }
    private Task RetryDirector() => Session.DirectCurrentAsync(retry: true);
    private async Task WatchFilm()
    {
        Session.WatchDirector();
        if (module is not null) await module.InvokeVoidAsync("closePopup", "director-dialog");
    }
    private void FilmSeek(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var value))
            Session.FilmCommand("seek", value);
    }
    private bool FilmNeedsRefresh() => Session.FilmFrame is { } current &&
        (Session.FilmPlaying || current.FilmTime != lastFilmTime || Session.FilmPlaying != lastFilmPlaying);
    private async Task InspectFilmScene()
    {
        try
        {
            var selected = Session.CurrentFilmEvidence();
            await InspectEvidence(selected.Evidence, selected.EventId);
        }
        catch (InvalidOperationException e) { evidenceNotice = e.Message; StateHasChanged(); }
    }
    private async Task PreviewDirector()
    {
        Session.PreviewRecordedDirector();
        if (module is not null) await module.InvokeVoidAsync("closePopup", "settings-dialog");
    }
    private async Task InspectEvidence(MomentEvidence captured, string id)
    {
        var evidence = captured.Resolve(id);
        try { Session.InspectEvidence(captured, id); evidenceNotice = null; }
        catch (InvalidOperationException e) { evidenceNotice = e.Message; StateHasChanged(); return; }
        await Refresh(true);
        if (frame?.Revision != captured.Revision) { evidenceNotice = "Match changed before evidence could be displayed."; StateHasChanged(); return; }
        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("closePopup", "moment-dialog");
                await module.InvokeVoidAsync("setEvidence", captured.Revision, JsonSerializer.Serialize(evidence, MomentJsonContext.Default.MomentEvent));
            }
            catch (JSDisconnectedException) { lifetime.Cancel(); }
            catch (JSException e) { evidenceNotice = $"Evidence view failed: {e.Message}"; Session.Command("pause"); StateHasChanged(); }
        }
    }
    private async Task InspectStory((MomentEvidence Evidence, string EventId) request)
    {
        if (module is not null) await module.InvokeVoidAsync("closePopup", "story-dialog");
        await InspectEvidence(request.Evidence, request.EventId);
    }
    private void Seek(double offset) => Session.Command("seek-by", offset);
    private void TimelineChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var value))
            Session.Command("seek", value);
        else error = "Invalid replay time.";
    }
    private void Select(string id)
    {
        Session.Command("select", id: id);
        view = Session.Sample(true);
        frame = view?.Frame;
        Open("player-dialog");
    }
    private void Mode(bool analyst) => Session.Command("mode", analyst ? 1 : 0);
    private async Task ReplayEvent(double time)
    {
        Session.Command("pause"); Session.Command("seek", time);
        if (module is not null) await module.InvokeVoidAsync("closePopup", "story-dialog");
    }
    private async Task Generate()
    {
        try{Session.OpenFixturePicker();fixtureError=null;if(Session.HasMatch)Open("fixture-dialog");}
        catch(InvalidOperationException exception){fixtureError=exception.Message;StateHasChanged();}
        await Task.CompletedTask;
    }
    private void SetFixtureChoice(FixtureChoice choice)
    {
        try{Session.SetFixtureChoice(choice);fixtureError=null;}
        catch(Exception exception) when(exception is ArgumentException or InvalidOperationException){fixtureError=exception.Message;}
    }
    private async Task CancelFixture()
    {Session.CancelFixturePicker();fixtureError=null;if(module is not null)await module.InvokeVoidAsync("closePopup","fixture-dialog");}
    private async Task CreateFixture()
    {
        Task request;
        try{request=Session.SubmitFixtureAsync();fixtureError=null;}
        catch(Exception exception) when(exception is ArgumentException or InvalidOperationException){fixtureError=exception.Message;StateHasChanged();return;}
        if(Session.HasMatch&&module is not null)
        {await module.InvokeVoidAsync("closePopup","fixture-dialog");Open("generation-dialog");}
        await request;
        if (!disposed && Session.RequestState == GenerationState.Succeeded && module is not null)
            await module.InvokeVoidAsync("closePopup", "generation-dialog");
    }
    [JSInvokable] public Task SelectFromPitch(string id) => InvokeAsync(() => Select(id));
    [JSInvokable] public Task PageHidden(double time, long revision) => InvokeAsync(() => Session.Freeze(time, revision));
    [JSInvokable] public Task KeyboardCommand(string command) => InvokeAsync(() =>
    {
        if (Session.FilmActive)
        {
            if (command == "toggle") Session.FilmCommand("toggle");
            else if (Session.FilmFrame is { } filmFrame) Session.FilmCommand("seek", filmFrame.FilmTime + (command == "back" ? -1 : 1));
            return;
        }
        switch (command)
        {
            case "toggle": Toggle(); break;
            case "back": Seek(-1); break;
            case "forward": Seek(1); break;
            default: throw new ArgumentException("Unknown keyboard command.");
        }
    });
    [JSInvokable] public Task FilmHidden() => InvokeAsync(() => { if (Session.FilmPlaying) Session.FilmCommand("toggle"); });
    public async ValueTask DisposeAsync()
    {
        disposed = true;
        Session.Changed -= Changed;
        Session.Command("pause");
        Session.Cancel();
        Session.Explainer.Cancel();
        Session.Director.Cancel();
        lifetime.Cancel();
        try
        {
            if (ticker is not null) await ticker;
            if (module is not null)
            {
                try { await module.InvokeVoidAsync("dispose"); await module.DisposeAsync(); }
                catch (JSDisconnectedException) { }
                catch (JSException e) { Console.Error.WriteLine($"Pitch teardown failed: {e.Message}"); }
            }
        }
        finally
        {
            reference?.Dispose();
            lifetime.Dispose();
        }
    }
}
