@implements IAsyncDisposable
@inject MatchService Session
@inject IJSRuntime JS

@if (frame is not null)
{
    var match = frame.Match;
    var snapshot = frame.Snapshot;
    var player = match.Player(frame.SelectedId);
    var stats = snapshot.Players.Single(p => p.PlayerId == player.Id);
    <div class="matchday">
        <header class="brand-bar">
            <div class="wordmark">PitchLens <span>Matchday</span></div>
            <button class="synthetic-badge" @onclick='() => Open("settings-dialog")'>Synthetic match · 6v6</button>
            <div class="actions">
                @if (Session.Generating) { <button class="button ghost" id="cancel-generation" @onclick="Session.Cancel">Cancel creation</button> }
                <button id="generate-match" class="button mint" @onclick='() => Open("generation-dialog")'>@(Session.Generating ? "Creating…" : "New match")</button>
            </div>
        </header>
        <div class="page-heading">
            <div><span class="eyebrow">Your match centre</span><h1>Every move matters.</h1></div>
            <div class="actions"><button id="players-button" class="button" @onclick='() => Open("roster-dialog")'>Players</button><button class="button purple" @onclick='() => Open("story-dialog")'>Match story</button></div>
        </div>
        <section class="score-strip" aria-label="Synthetic match score">
            <div class="team"><img src="images/arsenal_crest.png" alt="Arsenal crest" /><strong>Arsenal</strong></div>
            <div class="score-centre"><strong class="score">@snapshot.Score["arsenal"] : @snapshot.Score["manchester-city"]</strong><span>72-second synthetic replay</span></div>
            <div class="team away"><strong>Manchester City</strong><img src="images/manchester_city_crest.png" alt="Manchester City crest" /></div>
        </section>
        @if (error is not null) { <div class="error" role="alert">@error</div> }
        <main class="matchday-stage">
            <div class="pitch-slot">
                <canvas @ref="canvas" id="pitch" tabindex="0" role="img" aria-label="Synthetic football replay. Click a shirt, or use Players for keyboard-accessible selection."></canvas>
            </div>
            <div class="pitch-caption"><span>Click a shirt. Get the player lens.</span><span>@(frame.Story.LastOrDefault()?.Heading ?? "Play to reveal the story.")</span></div>
        </main>
        <footer class="transport">
            <button id="restart" class="button" @onclick='() => Command("restart")'>Restart</button>
            <button id="play-pause" class="button purple play" aria-keyshortcuts="Space" @onclick="Toggle" disabled="@(snapshot.Time >= match.Duration)">@(frame.Playing ? "Pause" : "Play")</button>
            <label class="scrub-label" for="timeline">Replay<input id="timeline" type="range" min="0" max="@match.Duration" step="0.1" @onchange="TimelineChanged" aria-label="Replay time in seconds" /></label>
            <output id="replay-clock" aria-live="off" aria-label="Current replay time"></output>
            <button class="text-button" @onclick='() => Open("settings-dialog")'>Settings</button>
        </footer>
        @if (Session.Generating)
        {
            <div class="request-status" role="status">Creating a synthetic match with Sol 6.1. Replay remains available.</div>
        }
        else if (Session.RequestState == GenerationState.Failed)
        {
            <div class="request-status error" role="alert">Creation failed. Previous match kept. <button class="text-button" @onclick='() => Open("generation-dialog")'>Details</button></div>
        }
        else if (Session.RequestState == GenerationState.Cancelled)
        {
            <div class="request-status" role="status">Creation cancelled. Previous match kept.</div>
        }

        <dialog id="player-dialog" class="player-dialog" aria-labelledby="player-title">
            <header class="dialog-head"><div><span class="eyebrow">Player lens</span><span class="caption">Synthetic facts at @snapshot.Time.ToString("00.0")s</span></div><button class="close" data-close-popup aria-label="Close player popup">Close</button></header>
            <div class="dialog-body">
                <div class="player-identity"><img src="@Crest(player.TeamId)" alt="@Club(match, player.TeamId)" /><div><h2 id="player-title">@player.Name</h2><p>@Club(match, player.TeamId) · #@player.Number</p></div></div>
                <dl class="player-stats">
                    <div><dt>Passes completed</dt><dd>@stats.CompletedPasses / @stats.Passes</dd></div>
                    <div><dt>Distance</dt><dd>@stats.Distance.ToString("F1") m</dd></div>
                    <div><dt>Pass accuracy</dt><dd class="@(stats.PassAccuracy is null ? "unavailable" : "")" title="@(stats.PassAccuracy is null ? "No pass attempts yet" : null)">@(stats.PassAccuracy is double accuracy ? accuracy.ToString("P0") : "Unavailable")</dd></div>
                    <div><dt>Goals</dt><dd>@stats.Goals</dd></div>
                </dl>
                <details><summary>More player facts</summary><p>Shots: @stats.Shots · Max speed: @stats.MaxSpeed.ToString("F2") m/s</p></details>
                <p class="caption">Replay paused for the player lens. Real roster name; invented match actions.</p>
            </div>
        </dialog>
        <dialog id="roster-dialog" aria-labelledby="roster-title">
            <header class="dialog-head"><div><h2 id="roster-title">Choose a player</h2><span class="caption">2026/27 roster names · Synthetic match</span></div><button class="close" data-close-popup>Close</button></header>
            <div class="dialog-body roster-list" id="roster">
                @foreach (var person in match.Players)
                {
                    <button @key="person.Id" @onclick="() => Select(person.Id)"><img src="@Crest(person.TeamId)" alt="" /><span>@person.Name<small>@Club(match, person.TeamId) · #@person.Number</small></span></button>
                }
            </div>
        </dialog>
        <dialog id="story-dialog" aria-labelledby="story-title">
            <header class="dialog-head"><div><span class="eyebrow">Match story</span><h2 id="story-title">@match.Story?.Title</h2><span class="caption">Only evidence observed through @snapshot.Time.ToString("00.0")s</span></div><button class="close" data-close-popup>Close</button></header>
            <div class="dialog-body">
                <div class="segments" id="mode"><button id="mode-casual" class="@(frame.Mode == ExplanationMode.Casual ? "selected" : "")" aria-pressed="@(frame.Mode == ExplanationMode.Casual ? "true" : "false")" @onclick="() => Mode(false)">Casual</button><button id="mode-analyst" class="@(frame.Mode == ExplanationMode.Analyst ? "selected" : "")" aria-pressed="@(frame.Mode == ExplanationMode.Analyst ? "true" : "false")" @onclick="() => Mode(true)">Analyst</button></div>
                @if (frame.Explanations.Count == 0) { <p>No events yet. Play to reveal the story.</p> }
                @foreach (var beat in frame.Story.Reverse())
                {
                    <article class="story-row" @key="(0, beat.Id)"><button class="evidence" @onclick="() => ReplayEvent(beat.Time)">@beat.Time.ToString("00.0")s</button><div><h3>@beat.Heading</h3><p>@beat.Detail</p><small>Events @string.Join(", ", beat.EventIds)</small></div></article>
                }
                @foreach (var explanation in frame.Explanations.Reverse())
                {
                    <article class="story-row" @key="(1, explanation.EventId)"><button class="evidence" @onclick="() => ReplayEvent(explanation.Time)">@explanation.Time.ToString("00.0")s</button><div><p>@explanation.Text</p><small>Event @explanation.EventId</small></div></article>
                }
            </div>
        </dialog>
        <dialog id="generation-dialog" aria-labelledby="generation-title">
            <header class="dialog-head"><div><span class="eyebrow">Copilot SDK</span><h2 id="generation-title">Create a new match.</h2><span class="caption">A real generation request, not a scripted preview.</span></div><button class="close" data-close-popup>Close</button></header>
            <div class="dialog-body">
                <p>Arsenal vs Manchester City · 72 seconds · Synthetic 6v6 story, player movement and events.</p>
                <p>Only GPT-6.1 Sol (@CopilotScenarioSource.Model), using normal local Copilot login. Creating a match may consume usage. No model fallback.</p>
                <div class="actions"><button class="button purple" @onclick="Generate" disabled="@Session.Generating">@(Session.Generating ? "Creating…" : "Create match with Sol 6.1")</button>@if (Session.Generating) { <button class="button" @onclick="Session.Cancel">Cancel creation</button> }</div>
                <p id="generation-status" role="@(Session.RequestState == GenerationState.Failed ? "alert" : "status")">@Session.Status</p>
                <p class="caption">Closing this popup does not cancel creation. Cancel is also available in the main brand bar. Invalid output or cancellation keeps the last valid match.</p>
            </div>
        </dialog>
        <dialog id="settings-dialog" aria-labelledby="settings-title">
            <header class="dialog-head"><div><h2 id="settings-title">Replay settings</h2><span class="caption">Source, model and local runtime</span></div><button class="close" data-close-popup>Close</button></header>
            <div class="dialog-body">
                <section id="scenario-provenance"><h3>@(view!.Fresh ? "New SDK-generated match" : "Recorded SDK example")</h3><p>Source model: @view.Model. @(view.Fresh ? "Generated in this session." : "Not a fresh request.")</p><p>All actions are synthetic. Real 2026/27 roster names; no real match result or athlete performance claim.</p></section>
                <div class="actions"><button class="button" @onclick="() => Seek(-5)">−5 seconds</button><button class="button" @onclick="() => Seek(5)">+5 seconds</button></div>
                <p>Space plays or pauses; Left/Right seek one second outside form controls and popups. Replay stays paused after closing a popup.</p>
                <details><summary>Advanced generation setup</summary><p>New requests use @CopilotScenarioSource.Model. Normal Copilot login and model access are required.</p><label for="cli">Compatible runtime override</label><input id="cli" placeholder="Bundled runtime (leave blank)" @bind="Session.CliOverride" disabled="@Session.Generating" /></details>
            </div>
        </dialog>
    </div>
}

@code {
    private PresentationFrame? frame;
    private NativeView? view;
    private ElementReference canvas;
    private IJSObjectReference? module;
    private DotNetObjectReference<MatchView>? reference;
    private readonly CancellationTokenSource lifetime = new();
    private Task? ticker;
    private bool disposed;
    private string? error;
    private long loadedRevision;
    private PopupRequest? pendingPopup;
    private sealed record PopupRequest(string Id, bool Adjacent, bool AtPointer);
    private static string Crest(string id) => id == "arsenal" ? "images/arsenal_crest.png" : "images/manchester_city_crest.png";
    private static string Club(Match match, string id) => match.Teams.Single(t => t.Id == id).Name;
    protected override void OnInitialized()
    {
        view = Session.Sample(true);
        frame = view?.Frame;
        Session.Changed += Changed;
    }
    protected override async Task OnAfterRenderAsync(bool first)
    {
        try
        {
            if (first)
            {
                var imported = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pitch.mjs");
                if (disposed) { await imported.DisposeAsync(); return; }
                module = imported;
                reference = DotNetObjectReference.Create(this);
                await module.InvokeVoidAsync("initialize", canvas, reference);
                await Refresh(true);
                ticker = Tick();
            }
            if (!disposed && module is not null && pendingPopup is { } popup)
            {
                pendingPopup = null;
                await module.InvokeVoidAsync("openPopup", popup.Id, popup.Adjacent, popup.AtPointer);
            }
        }
        catch (JSException e) { if (!disposed) { error = $"Match interface failed: {e.Message}"; Session.Command("pause"); StateHasChanged(); } }
    }
    private void Changed() { if (!disposed) _ = InvokeAsync(() => Refresh(true)); }
    private async Task Tick()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(250));
            while (await timer.WaitForNextTickAsync(lifetime.Token))
                if (!disposed && Session.Active && frame?.Playing == true) await InvokeAsync(() => Refresh(false));
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
    }
    private async Task Refresh(bool force)
    {
        if (disposed || error is not null) return;
        var next = Session.Sample(force);
        if (next is null) return;
        view = next;
        var current = next.Frame;
        frame = current;
        try
        {
            if (module is not null)
            {
                if (loadedRevision != current.Revision)
                {
                    loadedRevision = current.Revision;
                    await module.InvokeVoidAsync("loadScenario", WebContracts.Scenario(current.Match, current.Revision));
                }
                await module.InvokeVoidAsync("setClock", WebContracts.Clock(current));
            }
            StateHasChanged();
        }
        catch (JSDisconnectedException) { lifetime.Cancel(); }
        catch (JSException e) { error = $"Pitch interop failed: {e.Message}"; Session.Command("pause"); StateHasChanged(); }
    }
    private void Open(string id, bool adjacent = false, bool atPointer = false)
    {
        Session.Command("pause");
        pendingPopup = new(id, adjacent, atPointer);
        StateHasChanged();
    }
    private void Command(string command) => Session.Command(command);
    private void Toggle() => Command(frame?.Playing == true ? "pause" : "play");
    private void Seek(double offset) => Session.Command("seek-by", offset);
    private void TimelineChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var value))
            Session.Command("seek", value);
        else error = "Invalid replay time.";
    }
    private void Select(string id, bool fromPitch = false)
    {
        Session.Command("pause");
        Session.Command("select", id: id);
        Open("player-dialog", true, fromPitch);
    }
    private void Mode(bool analyst) => Session.Command("mode", analyst ? 1 : 0);
    private async Task ReplayEvent(double time)
    {
        Session.Command("pause"); Session.Command("seek", time);
        if (module is not null) await module.InvokeVoidAsync("closePopup", "story-dialog");
    }
    private async Task Generate()
    {
        await Session.GenerateAsync();
        if (!disposed && Session.RequestState == GenerationState.Succeeded && module is not null)
            await module.InvokeVoidAsync("closePopup", "generation-dialog");
    }
    [JSInvokable] public Task SelectFromPitch(string id) => InvokeAsync(() => Select(id, true));
    [JSInvokable] public Task PageHidden(double time, long revision) => InvokeAsync(() => Session.Freeze(time, revision));
    [JSInvokable] public Task KeyboardCommand(string command) => InvokeAsync(() =>
    {
        switch (command)
        {
            case "toggle": Toggle(); break;
            case "back": Seek(-1); break;
            case "forward": Seek(1); break;
            default: throw new ArgumentException("Unknown keyboard command.");
        }
    });
    public async ValueTask DisposeAsync()
    {
        disposed = true;
        Session.Changed -= Changed;
        Session.Command("pause");
        Session.Cancel();
        lifetime.Cancel();
        try
        {
            if (ticker is not null) await ticker;
            if (module is not null)
            {
                try { await module.InvokeVoidAsync("dispose"); await module.DisposeAsync(); }
                catch (JSDisconnectedException) { }
                catch (JSException e) { Console.Error.WriteLine($"Pitch teardown failed: {e.Message}"); }
            }
        }
        finally
        {
            reference?.Dispose();
            lifetime.Dispose();
        }
    }
}
