@implements IAsyncDisposable
@inject MatchService Session
@inject IJSRuntime JS

@if (frame is not null)
{
    var match = frame.Match;
    var snapshot = frame.Snapshot;
    var player = match.Player(frame.SelectedId);
    var stats = snapshot.Players.Single(p => p.PlayerId == player.Id);
    <div class="matchday">
        <header class="brand-bar">
            <div class="wordmark">PitchLens <span>Matchday</span></div>
            <button class="synthetic-badge" @onclick='() => Open("settings-dialog")'>Synthetic match · @($"{match.Players.Count / 2}v{match.Players.Count / 2}")</button>
            <div class="actions">
                @if (Session.Generating) { <button class="button ghost" id="cancel-generation" @onclick="Session.Cancel">Cancel creation</button> }
                <button id="generate-match" class="button mint" @onclick='() => Open("generation-dialog")'>@(Session.Generating ? "Creating…" : "New match")</button>
            </div>
        </header>
        <div class="page-heading">
            <div><span class="eyebrow">Matchday / Synthetic 11v11</span><h1>Arsenal <span class="fixture-versus">v</span> City</h1></div>
            <div class="actions"><button class="button purple" disabled="@(snapshot.Events.Count == 0)" @onclick="OpenMoment">Explain this moment</button><button id="players-button" class="button" @onclick='() => Open("roster-dialog")'>Players</button><button class="button purple" @onclick='() => Open("story-dialog")'>Match story</button></div>
        </div>
        <section class="score-strip" aria-label="Synthetic match score">
            <div class="team"><img src="images/arsenal_crest.png" alt="Arsenal crest" /><strong>Arsenal</strong></div>
            <div class="score-centre"><strong class="score" id="match-score" aria-label="Synthetic match score"></strong><span>@((int)(match.Duration / 60))-minute synthetic replay</span></div>
            <div class="team away"><strong>Manchester City</strong><img src="images/manchester_city_crest.png" alt="Manchester City crest" /></div>
        </section>
        @if (error is not null) { <div class="error" role="alert">@error</div> }
        <main class="matchday-stage">
            <div class="pitch-slot">
                <canvas @ref="canvas" id="pitch" tabindex="0" role="img" aria-label="Synthetic football replay. Click a shirt, or use Players for keyboard-accessible selection."></canvas>
                <div id="pitch-players" class="pitch-players" role="group" aria-label="Select a player on the pitch"></div>
                <div class="pitch-scorebug" aria-label="Synthetic match score"><span>ARS</span><strong id="pitch-bug-score"></strong><span>MCI</span><time id="pitch-bug-clock"></time></div>
                <div id="goal-banner" class="goal-banner" hidden role="status" aria-label="Goal celebration">
                    <div class="goal-card"><img id="goal-crest" alt="" /><div class="goal-copy"><span class="goal-event-tag">GOAL</span><span id="goal-team" class="goal-team"></span><strong id="goal-title"></strong><span id="goal-detail"></span></div><strong id="goal-score" class="goal-score"></strong></div>
                </div>
                <div id="goal-replay-tag" class="goal-replay-tag" hidden aria-live="off"><span></span> GOAL REPLAY <small>Back live at kickoff</small></div>
                <div id="evidence-view-tag" class="goal-replay-tag" hidden aria-live="off"></div>
                <div id="commentary-caption" class="commentary-caption" hidden aria-label="AI commentator subtitles" aria-live="off"></div>
            </div>
            <div class="pitch-caption"><span>Click a shirt. Get the player lens.</span><span>@(frame.Explanations.LastOrDefault()?.Text ?? "Play to reveal the story.")</span></div>
        </main>
        <footer class="transport">
            <button id="restart" class="button" @onclick='() => Command("restart")'>Restart</button>
            <button id="play-pause" class="button purple play" aria-keyshortcuts="Space" @onclick="Toggle">@(snapshot.Time >= match.Duration ? "Replay match" : frame.Playing ? "Pause" : "Play")</button>
            <label class="scrub-label" for="timeline">Replay<span class="scrub-track"><input id="timeline" type="range" min="0" max="@match.Duration" step="0.1" @onchange="TimelineChanged" aria-label="Replay time in seconds" />@foreach (var goal in snapshot.Events.Where(e => e.Kind == EventKind.Goal)) { <button class="goal-tick" style="left:@((goal.Time / match.Duration * 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%" aria-label="Watch @match.Player(goal.ActorId).Name goal at @goal.Time seconds" @onclick="() => WatchGoal(goal.Id)">●</button> }</span></label>
            <output id="replay-clock" aria-live="off" aria-label="Current replay time"></output>
            <label class="rate-control">Speed<select aria-label="Replay speed" value="@frame.Rate" @onchange="RateChanged"><option value="1">1x</option><option value="2">2x</option><option value="3">3x</option><option value="5">5x</option></select></label>
            <output id="effective-speed" class="effective-speed" aria-label="Effective replay pace"></output>
            <button class="button cc-button" aria-label="AI commentator subtitles" aria-pressed="@(captionsEnabled ? "true" : "false")" disabled="@(match.Commentary is null)" @onclick="ToggleCaptions">CC</button>
            <button class="text-button" @onclick='() => Open("settings-dialog")'>Settings</button>
        </footer>
        @if (Session.Generating)
        {
            <div class="request-status" role="status">Creating a synthetic match with Sol 6.1. Replay remains available.</div>
        }
        else if (Session.RequestState == GenerationState.Failed)
        {
            <div class="request-status error" role="alert">Creation failed. Previous match kept. <button class="text-button" @onclick='() => Open("generation-dialog")'>Details</button></div>
        }
        else if (Session.RequestState == GenerationState.Cancelled)
        {
            <div class="request-status" role="status">Creation cancelled. Previous match kept.</div>
        }
        @if (Session.Explainer.Busy)
        { <div class="request-status" role="status">Analysing the captured moment. <button class="text-button" @onclick="Session.Explainer.Cancel">Cancel explanation</button></div> }

        <dialog id="player-dialog" class="player-dialog" aria-modal="false" aria-labelledby="player-title">
            <header class="dialog-head"><div><span class="eyebrow">Player lens</span><span class="caption">Synthetic facts at @snapshot.Time.ToString("00.0")s</span></div><button class="close" data-close-popup aria-label="Close player popup">Close</button></header>
            <div class="dialog-body">
                <div class="player-identity"><img src="@Crest(player.TeamId)" alt="@Club(match, player.TeamId)" /><div><h2 id="player-title">@player.Name</h2><p>@Club(match, player.TeamId) · #@player.Number</p></div></div>
                <dl class="player-stats">
                    <div><dt>Passes completed</dt><dd>@stats.CompletedPasses / @stats.Passes</dd></div>
                    <div><dt>Distance</dt><dd>@stats.Distance.ToString("F1") m</dd></div>
                    <div><dt>Pass accuracy</dt><dd class="@(stats.PassAccuracy is null ? "unavailable" : "")" title="@(stats.PassAccuracy is null ? "No pass attempts yet" : null)">@(stats.PassAccuracy is double accuracy ? accuracy.ToString("P0") : "Unavailable")</dd></div>
                    <div><dt>Goals</dt><dd>@stats.Goals</dd></div>
                </dl>
                <details><summary>More player facts</summary><p>Shots: @stats.Shots · Max speed: @stats.MaxSpeed.ToString("F2") m/s</p></details>
                <p class="caption">Player facts at the replay time. Real roster name; invented match actions.</p>
            </div>
        </dialog>
        <dialog id="roster-dialog" aria-modal="false" aria-labelledby="roster-title">
            <header class="dialog-head"><div><h2 id="roster-title">Choose a player</h2><span class="caption">2026/27 roster names · Synthetic match</span></div><button class="close" data-close-popup>Close</button></header>
            <div class="dialog-body roster-list" id="roster">
                @foreach (var person in match.Players)
                {
                    <button @key="person.Id" @onclick="() => Select(person.Id)"><img src="@Crest(person.TeamId)" alt="" /><span>@person.Name<small>@Club(match, person.TeamId) · #@person.Number</small></span></button>
                }
            </div>
        </dialog>
        <dialog id="story-dialog" aria-labelledby="story-title">
            <header class="dialog-head"><div><span class="eyebrow">Match story</span><h2 id="story-title">@match.Story?.Title</h2><span class="caption">Only evidence observed through @snapshot.Time.ToString("00.0")s</span></div><button class="close" data-close-popup>Close</button></header>
            <div class="dialog-body">
                <div class="segments" id="mode"><button id="mode-casual" class="@(frame.Mode == ExplanationMode.Casual ? "selected" : "")" aria-pressed="@(frame.Mode == ExplanationMode.Casual ? "true" : "false")" @onclick="() => Mode(false)">Casual</button><button id="mode-analyst" class="@(frame.Mode == ExplanationMode.Analyst ? "selected" : "")" aria-pressed="@(frame.Mode == ExplanationMode.Analyst ? "true" : "false")" @onclick="() => Mode(true)">Analyst</button></div>
                @if (frame.Explanations.Count == 0) { <p>No events yet. Play to reveal the story.</p> }
                @foreach (var beat in frame.Story.Reverse())
                {
                    <article class="story-row" @key="(0, beat.Id)"><button class="evidence" @onclick="() => ReplayEvent(beat.Time)">@beat.Time.ToString("00.0")s</button><div><h3>@beat.Heading</h3><p>@beat.Detail</p><small>Events @string.Join(", ", beat.EventIds)</small></div></article>
                }
                @foreach (var explanation in frame.Explanations.Reverse())
                {
                    <article class="story-row" @key="(1, explanation.EventId)"><button class="evidence" @onclick="() => ReplayEvent(explanation.Time)">@explanation.Time.ToString("00.0")s</button><div><p>@explanation.Text</p><small>Event @explanation.EventId</small></div></article>
                }
            </div>
        </dialog>
        <dialog id="moment-dialog" class="moment-dialog" aria-labelledby="moment-title">
            <header class="dialog-head"><div><span class="eyebrow">Evidence studio / Copilot SDK</span><h2 id="moment-title">Explain this moment</h2></div><button class="close" data-close-popup>Close</button></header>
            <div class="dialog-body">
                <p class="caption">Synthetic football. Captured evidence, not live scouting. Opening this panel or switching modes makes no AI request.</p>
                @if (snapshot.Time >= 86 && MomentRecording.Available(match, frame.Revision))
                { <button class="button" disabled="@Session.Explainer.Busy" @onclick="Session.LoadRecordedMoment">View recorded goal analysis · 86s · No AI call</button> }
                @if (Session.ExplanationSnapshot is { } captured)
                {
                    <label for="moment-event">Observed moment through @captured.Cutoff.ToString("0.0")s</label>
                    <select id="moment-event" value="@captured.FocusId" disabled="@Session.Explainer.Busy" @onchange="MomentChanged">
                        @foreach (var e in snapshot.Events.TakeLast(12).Reverse())
                        { <option value="@e.Id">@e.Time.ToString("0.0")s · @e.Kind · @match.Player(e.ActorId).Name</option> }
                    </select>
                    <p>One explicit <strong>gpt-6.1-sol</strong> request returns both modes. It may consume Copilot usage, including up to six read-only evidence tool calls. Response budget 270 seconds, then bounded SDK cleanup; no automatic retry or fallback.</p>
                    <div class="actions"><button class="button mint" disabled="@(Session.Explainer.Busy || Session.Generating || Session.CheckingConnection)" @onclick="Session.ExplainAsync">Ask Sol about this moment</button>@if (Session.Explainer.Busy) { <button class="button" @onclick="Session.Explainer.Cancel">Cancel explanation</button> }</div>
                }
                <p role="status">@Session.Explainer.Status</p>
                @if (Session.Explainer.VisibleAt(frame.Revision, snapshot.Time) is { } explained)
                {
                    <div class="moment-provenance">@(explained.Fresh ? "Fresh SDK" : "Recorded SDK / Not fresh") · @CopilotScenarioSource.Model · Captured @explained.Evidence.Cutoff.ToString("0.0")s · Revision @explained.Evidence.Revision · @explained.ToolCalls @(explained.Fresh ? "read-only tool calls" : "tool calls in original recording")</div>
                    <div class="segments"><button class="@(momentAnalyst ? "" : "selected")" aria-pressed="@(!momentAnalyst ? "true" : "false")" @onclick="() => momentAnalyst = false">Fan</button><button class="@(momentAnalyst ? "selected" : "")" aria-pressed="@(momentAnalyst ? "true" : "false")" @onclick="() => momentAnalyst = true">Analyst</button></div>
                    <p class="caption">AI interpretation, not verified causal truth. References and snapshot identity are checked; prose can still be wrong.</p>
                    @foreach (var claim in (momentAnalyst ? explained.Answer.Analyst : explained.Answer.Fan))
                    {
                        <article class="moment-claim"><p>@claim.Text</p><div class="actions">@foreach (var id in claim.EvidenceIds)
                            {
                                var fact = explained.Evidence.Resolve(id);
                                <button class="evidence" @onclick="() => InspectEvidence(explained.Evidence, id)">@fact.Time.ToString("0.0")s · @fact.Kind · @id</button>
                            }</div></article>
                    }
                    <details><summary>Local measured facts / captured snapshot</summary>
                        <p class="caption">Totals through @explained.Evidence.Cutoff.ToString("0.0")s. Not calculated by AI. Pass accuracy is unavailable before any attempts.</p>
                        @foreach (var metric in explained.Evidence.Facts.Players.Where(p => explained.Evidence.Facts.Events.Any(e => e.Actor == p.Name || e.Receiver == p.Name)))
                        { <p><strong>@metric.Name</strong> · Passes @metric.CompletedPasses/@metric.Passes · Accuracy @(metric.Passes == 0 ? "Unavailable" : ((double)metric.CompletedPasses / metric.Passes).ToString("P0")) · Shots @metric.Shots · Goals @metric.Goals · @metric.DistanceMetres.ToString("F1") m · Max @metric.MaxSpeedMetresPerSecond.ToString("F2") m/s</p> }
                        <small>Snapshot SHA-256 @explained.Evidence.Hash</small>
                    </details>
                }
                else if (Session.Explainer.Current is { } hiddenExplanation)
                { <p class="caption">Saved analysis is hidden before its captured cutoff of @hiddenExplanation.Evidence.Cutoff.ToString("0.0")s. Seek forward to that time to view it again.</p> }
            </div>
        </dialog>
        <dialog id="generation-dialog" aria-labelledby="generation-title">
            <header class="dialog-head"><div><span class="eyebrow">Copilot SDK</span><h2 id="generation-title">Create a new match.</h2><span class="caption">A real generation request, not a scripted preview.</span></div><button class="close" data-close-popup>Close</button></header>
            <div class="dialog-body">
                <p>Arsenal vs Manchester City · Five minutes (300 seconds) · Synthetic 11v11. All 22 player paths and events authored by AI.</p>
                <p>Only GPT-6.1 Sol (@CopilotScenarioSource.Model), using normal local Copilot login. Paths/events, at most one AI path correction for a rejected team shape, then grounded subtitles: at most three model responses, bounded to fifteen minutes. May consume usage. No model fallback.</p>
                <div class="actions"><button class="button purple" @onclick="Generate" disabled="@(Session.Generating || Session.CheckingConnection)">@(Session.Generating ? "Creating…" : "Create match with Sol 6.1")</button>@if (Session.Generating) { <button class="button" @onclick="Session.Cancel">Cancel creation</button> }</div>
                <p id="generation-status" role="@(Session.RequestState == GenerationState.Failed ? "alert" : "status")">@Session.Status</p>
                <p class="caption">Closing this popup does not cancel creation. Cancel is also available in the main brand bar. Invalid output or cancellation keeps the last valid match.</p>
            </div>
        </dialog>
        <dialog id="settings-dialog" aria-labelledby="settings-title">
            <header class="dialog-head"><div><h2 id="settings-title">Replay settings</h2><span class="caption">Source, model and local runtime</span></div><button class="close" data-close-popup>Close</button></header>
            <div class="dialog-body">
                <section id="scenario-provenance"><h3>@(view!.Origin == ScenarioOrigin.DeterministicDemo ? "Authored five-minute demo" : view.Fresh ? "New SDK-generated match" : "Recorded SDK example")</h3><p>Source model: @(view.Model ?? "None — authored locally"). @(view.Fresh ? "Generated in this session." : "Not a fresh request.")</p><p>All actions are synthetic. Real 2026/27 roster names; no real match result or athlete performance claim.</p></section>
                <p>@(match.Commentary is { } commentary ? $"AI commentator subtitles: {commentary.Model}, {commentary.Cues.Count} timed cues for this match. {(view.Fresh ? "Generated with this match." : "Recorded generation, not a fresh request.")} Match story facts remain scripted." : "AI commentator subtitles unavailable; match story facts are scripted, not AI commentary.")</p>
                @if (match.Players.Count == 22)
                {
                    <p>All 22 explicit player trajectories and events were authored by Sol. The viewer only interpolates those knots; ball motion follows validated possession and events. No procedural support-path or formation solver. Illustrative 11v11 selection, not an actual starting XI.</p>
                }
                <div class="actions"><button class="button" @onclick="() => Seek(-5)">−5 seconds</button><button class="button" @onclick="() => Seek(5)">+5 seconds</button></div>
                <button class="button" aria-pressed="@(frame.HighlightsEnabled ? "true" : "false")" @onclick="ToggleGoalReplays">Goal highlights: @(frame.HighlightsEnabled ? "On" : "Off")</button>
                <p class="caption">Highlights use a contextual 2D camera and readable 1x buildup/finish/replay pace, then restore your selected speed at kickoff. The native clock owns both rates. Reduced motion keeps the tactical camera and suppresses extra effects.</p>
                <p>Space plays or pauses; Left/Right seek one second outside form controls. Player lens and roster preserve playback. Story, settings and creation pause replay.</p>
                <details><summary>Advanced generation setup</summary><p>New requests use @CopilotScenarioSource.Model. Normal Copilot login and model access are required.</p><label for="cli">Compatible runtime override</label><input id="cli" placeholder="Bundled runtime (leave blank)" @bind="Session.CliOverride" disabled="@(Session.Generating || Session.CheckingConnection)" /><button class="button" @onclick="Session.CheckConnectionAsync" disabled="@(Session.Generating || Session.CheckingConnection)">Check SDK connection (no generation)</button><p role="status">@Session.ConnectionStatus</p></details>
            </div>
        </dialog>
    </div>
}

@code {
    private PresentationFrame? frame;
    private NativeView? view;
    private ElementReference canvas;
    private IJSObjectReference? module;
    private DotNetObjectReference<MatchView>? reference;
    private readonly CancellationTokenSource lifetime = new();
    private Task? ticker;
    private bool disposed;
    private string? error;
    private long loadedRevision;
    private PopupRequest? pendingPopup;
    private bool captionsEnabled = true;
    private bool momentAnalyst;
    private sealed record PopupRequest(string Id);
    private static string Crest(string id) => id == "arsenal" ? "images/arsenal_crest.png" : "images/manchester_city_crest.png";
    private static string Club(Match match, string id) => match.Teams.Single(t => t.Id == id).Name;
    protected override void OnInitialized()
    {
        view = Session.Sample(true);
        frame = view?.Frame;
        Session.Changed += Changed;
    }
    protected override async Task OnAfterRenderAsync(bool first)
    {
        try
        {
            if (first)
            {
                var imported = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pitch.mjs");
                if (disposed) { await imported.DisposeAsync(); return; }
                module = imported;
                reference = DotNetObjectReference.Create(this);
                await module.InvokeVoidAsync("initialize", canvas, reference);
                await Refresh(true);
                await module.InvokeVoidAsync("setCaptionsEnabled", captionsEnabled);
                ticker = Tick();
            }
            if (!disposed && module is not null && pendingPopup is { } popup)
            {
                pendingPopup = null;
                await module.InvokeVoidAsync("openPopup", popup.Id, frame?.SelectedId);
            }
        }
        catch (JSException e) { if (!disposed) { error = $"Match interface failed: {e.Message}"; Session.Command("pause"); StateHasChanged(); } }
    }
    private void Changed() { if (!disposed) _ = InvokeAsync(() => Refresh(true)); }
    private async Task Tick()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(250));
            while (await timer.WaitForNextTickAsync(lifetime.Token))
                if (!disposed && Session.Active && frame?.Playing == true) await InvokeAsync(() => Refresh(false));
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
    }
    private async Task Refresh(bool force)
    {
        if (disposed || error is not null) return;
        var next = Session.Sample(force);
        if (next is null) return;
        view = next;
        var current = next.Frame;
        frame = current;
        try
        {
            if (module is not null)
            {
                if (loadedRevision != current.Revision)
                {
                    loadedRevision = current.Revision;
                    await module.InvokeVoidAsync("loadScenario", WebContracts.Scenario(current.Match, current.Revision));
                }
                await module.InvokeVoidAsync("setClock", WebContracts.Clock(current));
            }
            StateHasChanged();
        }
        catch (JSDisconnectedException) { lifetime.Cancel(); }
        catch (JSException e) { error = $"Pitch interop failed: {e.Message}"; Session.Command("pause"); StateHasChanged(); }
    }
    private void Open(string id)
    {
        if (id is not ("player-dialog" or "roster-dialog")) Session.Command("pause");
        pendingPopup = new(id);
        StateHasChanged();
    }
    private void Command(string command) => Session.Command(command);
    private void Toggle() => Command("toggle");
    private void RateChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var rate) && Playback.IsSupportedRate(rate))
            Session.Command("rate", rate);
        else error = "Invalid replay speed.";
    }
    private async Task ToggleCaptions()
    {
        captionsEnabled = !captionsEnabled;
        try { if (module is not null) await module.InvokeVoidAsync("setCaptionsEnabled", captionsEnabled); }
        catch (JSDisconnectedException) { lifetime.Cancel(); }
        catch (JSException e) { error = $"Subtitle control failed: {e.Message}"; Session.Command("pause"); }
    }
    private void ToggleGoalReplays() => Session.Command("highlights", frame?.HighlightsEnabled == true ? 0 : 1);
    private void WatchGoal(string id) => Session.Command("watch-goal", id: id);
    private void OpenMoment()
    {
        if (!Session.Explainer.Busy) Session.CaptureMoment();
        Open("moment-dialog");
    }
    private void MomentChanged(ChangeEventArgs e) => Session.CaptureMoment(e.Value?.ToString());
    private async Task InspectEvidence(MomentEvidence captured, string id)
    {
        if (frame?.Revision != captured.Revision) { error = "This evidence belongs to an earlier match."; return; }
        var evidence = captured.Resolve(id);
        Session.Command("pause"); Session.Command("seek", evidence.Time);
        await Refresh(true);
        if (module is not null)
        {
            await module.InvokeVoidAsync("closePopup", "moment-dialog");
            await module.InvokeVoidAsync("setEvidence", captured.Revision, JsonSerializer.Serialize(evidence, MomentJsonContext.Default.MomentEvent));
        }
    }
    private void Seek(double offset) => Session.Command("seek-by", offset);
    private void TimelineChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var value))
            Session.Command("seek", value);
        else error = "Invalid replay time.";
    }
    private void Select(string id)
    {
        Session.Command("select", id: id);
        view = Session.Sample(true);
        frame = view?.Frame;
        Open("player-dialog");
    }
    private void Mode(bool analyst) => Session.Command("mode", analyst ? 1 : 0);
    private async Task ReplayEvent(double time)
    {
        Session.Command("pause"); Session.Command("seek", time);
        if (module is not null) await module.InvokeVoidAsync("closePopup", "story-dialog");
    }
    private async Task Generate()
    {
        await Session.GenerateAsync();
        if (!disposed && Session.RequestState == GenerationState.Succeeded && module is not null)
            await module.InvokeVoidAsync("closePopup", "generation-dialog");
    }
    [JSInvokable] public Task SelectFromPitch(string id) => InvokeAsync(() => Select(id));
    [JSInvokable] public Task PageHidden(double time, long revision) => InvokeAsync(() => Session.Freeze(time, revision));
    [JSInvokable] public Task KeyboardCommand(string command) => InvokeAsync(() =>
    {
        switch (command)
        {
            case "toggle": Toggle(); break;
            case "back": Seek(-1); break;
            case "forward": Seek(1); break;
            default: throw new ArgumentException("Unknown keyboard command.");
        }
    });
    public async ValueTask DisposeAsync()
    {
        disposed = true;
        Session.Changed -= Changed;
        Session.Command("pause");
        Session.Cancel();
        Session.Explainer.Cancel();
        lifetime.Cancel();
        try
        {
            if (ticker is not null) await ticker;
            if (module is not null)
            {
                try { await module.InvokeVoidAsync("dispose"); await module.DisposeAsync(); }
                catch (JSDisconnectedException) { }
                catch (JSException e) { Console.Error.WriteLine($"Pitch teardown failed: {e.Message}"); }
            }
        }
        finally
        {
            reference?.Dispose();
            lifetime.Dispose();
        }
    }
}
