@implements IAsyncDisposable
@inject MatchService Session
@inject IJSRuntime JS

@if (frame is not null)
{
    var match = frame.Match;
    var snapshot = frame.Snapshot;
    var player = match.Player(frame.SelectedId);
    var stats = snapshot.Players.Single(p => p.PlayerId == player.Id);
    <div class="app">
        <header class="match-toolbar">
            <div class="match-identity" aria-label="Arsenal versus Manchester City">
                <img src="images/arsenal_crest.png" alt="Arsenal crest" /><span>Arsenal</span>
                <strong class="score">@snapshot.Score["arsenal"] <span>–</span> @snapshot.Score["manchester-city"]</strong>
                <span>Man City</span><img src="images/manchester_city_crest.png" alt="Manchester City crest" />
            </div>
            <div class="toolbar-actions">
                <details class="source-info">
                    <summary>Synthetic match</summary>
                    <div class="source-content" id="scenario-provenance">
                        <strong>@(view!.Fresh ? "New SDK-generated match" : "Recorded SDK example")</strong>
                        <p>Source model: @view.Model. @(view.Fresh ? "Generated in this session." : "Not a fresh request.")</p>
                        <p>2026/27 Arsenal and Manchester City names. All actions are invented; this is a reduced-sided 6v6 example, not a real result.</p>
                    </div>
                </details>
                <button id="generate-match" class="new-match" @onclick="Generate" disabled="@Session.Generating">@(Session.Generating ? "Creating…" : "New match")</button>
            </div>
        </header>
        @if (error is not null) { <div class="error" role="alert">@error</div> }
        <main>
            <section class="pitch-panel panel" aria-label="Match replay">
                <div class="pitch-slot">
                    <canvas @ref="canvas" id="pitch" role="img" aria-label="Animated football replay. Choose a player using the player selector for keyboard-accessible selection."></canvas>
                </div>
            </section>
            <aside class="panel inspector" aria-label="Selected player">
                <label for="roster">Player</label>
                <select id="roster" value="@frame.SelectedId" @onchange="RosterChanged">
                    @foreach (var p in match.Players) { <option value="@p.Id">@p.Name · @p.Number</option> }
                </select>
                <div class="player-identity">
                    <img src="@Crest(player.TeamId)" alt="@Club(match, player.TeamId)" />
                    <div><h1>@player.Name</h1><span>@Club(match, player.TeamId) · #@player.Number</span></div>
                </div>
                <dl class="key-stats">
                    <dt>Passes completed</dt><dd>@stats.CompletedPasses / @stats.Passes</dd>
                    <dt>Pass accuracy</dt><dd title="@(stats.PassAccuracy is null ? "No pass attempts yet" : null)">@(stats.PassAccuracy is double accuracy ? accuracy.ToString("P0") : "Unavailable")</dd>
                    <dt>Distance</dt><dd>@stats.Distance.ToString("F1") m</dd>
                    <dt>Goals</dt><dd>@stats.Goals</dd>
                </dl>
                <details class="disclosure">
                    <summary>More</summary>
                    <dl><dt>Shots</dt><dd>@stats.Shots</dd><dt>Max speed</dt><dd>@stats.MaxSpeed.ToString("F2") m/s</dd></dl>
                    <p class="secondary">Statistics follow the replay time. Pass accuracy is unavailable before any attempts. Movement is trajectory-derived, not measured athlete performance.</p>
                    <p class="secondary">Space: play/pause. Left and Right arrows: seek one second, outside form controls.</p>
                </details>
                <details class="disclosure">
                    <summary>Match story</summary>
                    <h2 id="story-title">@match.Story?.Title</h2>
                    <p class="secondary" id="current-story-beat">@(frame.Story.LastOrDefault() is { } currentBeat ? $"{currentBeat.Time:00.0}s · {currentBeat.Heading}" : "Play to reveal the story.")</p>
                    <div class="segments" id="mode">
                        <button id="mode-casual" class="@(frame.Mode == ExplanationMode.Casual ? "selected" : "")" aria-pressed="@(frame.Mode == ExplanationMode.Casual ? "true" : "false")" @onclick="() => Mode(false)">Casual</button>
                        <button id="mode-analyst" class="@(frame.Mode == ExplanationMode.Analyst ? "selected" : "")" aria-pressed="@(frame.Mode == ExplanationMode.Analyst ? "true" : "false")" @onclick="() => Mode(true)">Analyst</button>
                    </div>
                    @foreach (var beat in frame.Story.Reverse())
                    {
                        <article class="note" @key="(0, beat.Id)"><h3>@beat.Heading</h3><p>@beat.Detail</p><small>@beat.Time.ToString("00.0")s · @string.Join(", ", beat.EventIds)</small></article>
                    }
                    @foreach (var explanation in frame.Explanations.Reverse())
                    {
                        <article class="note" @key="(1, explanation.EventId)"><button class="evidence" @onclick="() => ReplayEvent(explanation.Time)">@explanation.Time.ToString("00.0")s · @explanation.EventId</button><p>@explanation.Text</p></article>
                    }
                </details>
                <details class="disclosure">
                    <summary>Settings</summary>
                    <p>New matches use GPT-6.1 Sol (@CopilotScenarioSource.Model). Normal Copilot login and model access are required. Each request may consume usage.</p>
                    <label for="cli">Advanced: compatible runtime override</label>
                    <input id="cli" placeholder="Bundled runtime" @bind="Session.CliOverride" disabled="@Session.Generating" />
                    <p class="secondary">Leave blank unless using a compatible local runtime.</p>
                    <p class="secondary">@Session.Status</p>
                </details>
            </aside>
        </main>
        <footer class="transport">
            <div class="timeline"><label for="timeline">Replay</label><input id="timeline" type="range" min="0" max="@match.Duration" step="0.1" @onchange="TimelineChanged" aria-label="Replay time in seconds" /><output id="replay-clock" aria-live="off" aria-label="Current replay time"></output></div>
            <div class="controls">
                <button id="restart" @onclick='() => Command("restart")'>Restart</button>
                <button id="seek-back" @onclick="() => Seek(-5)" aria-label="Seek backward five seconds">−5 s</button>
                <button id="play-pause" class="primary" aria-keyshortcuts="Space" @onclick="Toggle" disabled="@(snapshot.Time >= match.Duration)">@(frame.Playing ? "Pause" : "Play")</button>
                <button id="seek-forward" @onclick="() => Seek(5)" aria-label="Seek forward five seconds">+5 s</button>
            </div>
        </footer>
        @if (Session.Generating)
        {
            <div class="request-status" role="status"><span>Creating a synthetic match with Sol 6.1…</span><button id="cancel-generation" @onclick="Session.Cancel">Cancel</button></div>
        }
        else if (Session.RequestState == GenerationState.Failed)
        {
            <div class="request-status error" role="alert"><span>Could not create the match. Previous match kept.</span><details><summary>Details</summary><p id="generation-status">@Session.Status</p></details></div>
        }
        else if (Session.RequestState == GenerationState.Cancelled)
        {
            <div class="request-status secondary" role="status">Creation cancelled. Previous match kept.</div>
        }
    </div>
}

@code {
    private PresentationFrame? frame;
    private NativeView? view;
    private ElementReference canvas;
    private IJSObjectReference? module;
    private DotNetObjectReference<MatchView>? reference;
    private readonly CancellationTokenSource lifetime = new();
    private Task? ticker;
    private bool disposed;
    private string? error;
    private long loadedRevision;
    private static string Crest(string id) => id == "arsenal" ? "images/arsenal_crest.png" : "images/manchester_city_crest.png";
    private static string Club(Match match, string id) => match.Teams.Single(t => t.Id == id).Name;
    protected override void OnInitialized()
    {
        view = Session.Sample(true);
        frame = view?.Frame;
        Session.Changed += Changed;
    }
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!first) return;
        try
        {
            var imported = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pitch.mjs");
            if (disposed) { await imported.DisposeAsync(); return; }
            module = imported;
            reference = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("initialize", canvas, reference);
            await Refresh(true);
            ticker = Tick();
        }
        catch (JSException e) { if (!disposed) { error = $"Pitch initialization failed: {e.Message}"; Session.Command("pause"); StateHasChanged(); } }
    }
    private void Changed() { if (!disposed) _ = InvokeAsync(() => Refresh(true)); }
    private async Task Tick()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(250));
            while (await timer.WaitForNextTickAsync(lifetime.Token))
                if (!disposed && Session.Active && frame?.Playing == true) await InvokeAsync(() => Refresh(false));
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
    }
    private async Task Refresh(bool force)
    {
        if (disposed || error is not null) return;
        var next = Session.Sample(force);
        if (next is null) return;
        view = next;
        var current = next.Frame;
        frame = current;
        try
        {
            if (module is not null)
            {
                if (loadedRevision != current.Revision)
                {
                    loadedRevision = current.Revision;
                    await module.InvokeVoidAsync("loadScenario", WebContracts.Scenario(current.Match, current.Revision));
                }
                await module.InvokeVoidAsync("setClock", WebContracts.Clock(current));
            }
            StateHasChanged();
        }
        catch (JSDisconnectedException) { lifetime.Cancel(); }
        catch (JSException e) { error = $"Pitch interop failed: {e.Message}"; Session.Command("pause"); StateHasChanged(); }
    }
    private void Command(string command) => Session.Command(command);
    private void Toggle() => Command(frame?.Playing == true ? "pause" : "play");
    private void Seek(double offset) => Session.Command("seek-by", offset);
    private void TimelineChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var value))
            Session.Command("seek", value);
        else error = "Invalid replay time.";
    }
    private void RosterChanged(ChangeEventArgs e) => Select(e.Value?.ToString() ?? "");
    private void Select(string id) => Session.Command("select", id: id);
    private void Mode(bool analyst) => Session.Command("mode", analyst ? 1 : 0);
    private void ReplayEvent(double time) { Session.Command("pause"); Session.Command("seek", time); }
    private Task Generate() => Session.GenerateAsync();
    [JSInvokable] public Task SelectFromPitch(string id) => InvokeAsync(() => Select(id));
    [JSInvokable] public Task PageHidden(double time, long revision) => InvokeAsync(() => Session.Freeze(time, revision));
    [JSInvokable] public Task KeyboardCommand(string command) => InvokeAsync(() =>
    {
        switch (command)
        {
            case "toggle": Toggle(); break;
            case "back": Seek(-1); break;
            case "forward": Seek(1); break;
            default: throw new ArgumentException("Unknown keyboard command.");
        }
    });
    public async ValueTask DisposeAsync()
    {
        disposed = true;
        Session.Changed -= Changed;
        Session.Command("pause");
        Session.Cancel();
        lifetime.Cancel();
        try
        {
            if (ticker is not null) await ticker;
            if (module is not null)
            {
                try { await module.InvokeVoidAsync("dispose"); await module.DisposeAsync(); }
                catch (JSDisconnectedException) { }
                catch (JSException e) { Console.Error.WriteLine($"Pitch teardown failed: {e.Message}"); }
            }
        }
        finally
        {
            reference?.Dispose();
            lifetime.Dispose();
        }
    }
}
