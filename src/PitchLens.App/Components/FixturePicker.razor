<section class="fixture-picker" aria-labelledby="fixture-picker-title">
    <header>
        <div class="section-with-info">
            @if(Startup){<h1 id="fixture-picker-title">Choose your teams</h1>}else{<h2 id="fixture-picker-title">Choose your teams</h2>}
            <InfoDisclosure About="creating a match">Choose two different clubs or use Random; the matchup is chosen only when you press Create. Official selected squad identities, not an actual starting XI. GPT-6.1 Sol authors five minutes of paths, events and narration. Normal Copilot access is required after Create. Up to three responses, one shared correction, fifteen minutes overall and 270 seconds per response. No automatic retry.</InfoDisclosure>
        </div>
        <span class="caption">Synthetic match</span>
    </header>
    <div class="segments" role="group" aria-label="Fixture selection">
        <button id="fixture-manual" class="@(Value.Kind==FixtureChoiceKind.Manual?"selected":"")" aria-pressed="@(Value.Kind==FixtureChoiceKind.Manual?"true":"false")" disabled="@Busy" @onclick="()=>Changed.InvokeAsync(new FixtureChoice())">Choose clubs</button>
        <button id="fixture-random" class="@(Value.Kind==FixtureChoiceKind.Random?"selected":"")" aria-pressed="@(Value.Kind==FixtureChoiceKind.Random?"true":"false")" disabled="@Busy" @onclick="()=>Changed.InvokeAsync(FixtureChoice.Random)">Random matchup</button>
    </div>
    @if(Value.Kind==FixtureChoiceKind.Manual)
    {
        <div class="fixture-choices">
            <label for="fixture-home"><span>Home</span><span class="club-input"><img src="@FixtureCatalog.Clubs.Single(t=>t.Id==Value.HomeId).Crest" alt="" /><select id="fixture-home" value="@Value.HomeId" disabled="@Busy" @onchange="e=>Changed.InvokeAsync(Value with{HomeId=e.Value?.ToString()})">@foreach(var club in FixtureCatalog.Clubs){<option value="@club.Id" disabled="@(club.Id==Value.AwayId)">@club.Name</option>}</select></span></label>
            <label for="fixture-away"><span>Away</span><span class="club-input"><img src="@FixtureCatalog.Clubs.Single(t=>t.Id==Value.AwayId).Crest" alt="" /><select id="fixture-away" value="@Value.AwayId" disabled="@Busy" @onchange="e=>Changed.InvokeAsync(Value with{AwayId=e.Value?.ToString()})">@foreach(var club in FixtureCatalog.Clubs){<option value="@club.Id" disabled="@(club.Id==Value.HomeId)">@club.Name</option>}</select></span></label>
        </div>
    }
    @if(!string.IsNullOrWhiteSpace(Error)){<p class="error" role="alert">@Error</p>}
    <div class="fixture-primary"><button id="fixture-create" class="button purple" disabled="@(Busy||!string.IsNullOrWhiteSpace(Error))" @onclick="Create">Create match</button><small>Uses Copilot usage · Up to 3 responses</small></div>
    <button id="fixture-cancel" class="text-button fixture-back" disabled="@Busy" @onclick="Cancel">Back</button>
</section>
@code{
    [Parameter] public FixtureChoice Value{get;set;}=new();
    [Parameter] public bool Busy{get;set;}
    [Parameter] public bool Startup{get;set;}
    [Parameter] public string? Error{get;set;}
    [Parameter] public EventCallback<FixtureChoice> Changed{get;set;}
    [Parameter] public EventCallback Create{get;set;}
    [Parameter] public EventCallback Cancel{get;set;}
}
