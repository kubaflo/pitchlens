<section class="fixture-picker" aria-labelledby="fixture-picker-title">
    <div><span class="eyebrow">Your next matchday</span><h2 id="fixture-picker-title">Choose the teams.</h2><p class="caption">Live AI only · Synthetic actions, not a real starting XI or match result. No SDK request until Create.</p></div>
    <div class="segments" role="group" aria-label="Fixture selection">
        <button id="fixture-manual" class="@(Value.Kind==FixtureChoiceKind.Manual?"selected":"")" aria-pressed="@(Value.Kind==FixtureChoiceKind.Manual?"true":"false")" disabled="@Busy" @onclick="()=>Changed.InvokeAsync(new FixtureChoice())">Choose clubs</button>
        <button id="fixture-random" class="@(Value.Kind==FixtureChoiceKind.Random?"selected":"")" aria-pressed="@(Value.Kind==FixtureChoiceKind.Random?"true":"false")" disabled="@Busy" @onclick="()=>Changed.InvokeAsync(FixtureChoice.Random)">Random matchup</button>
    </div>
    @if(Value.Kind==FixtureChoiceKind.Manual)
    {
        <div class="fixture-choices">
            <label for="fixture-home">Home<select id="fixture-home" value="@Value.HomeId" disabled="@Busy" @onchange="e=>Changed.InvokeAsync(Value with{HomeId=e.Value?.ToString()})">@foreach(var club in FixtureCatalog.Clubs){<option value="@club.Id" disabled="@(club.Id==Value.AwayId)">@club.Name</option>}</select></label>
            <label for="fixture-away">Away<select id="fixture-away" value="@Value.AwayId" disabled="@Busy" @onchange="e=>Changed.InvokeAsync(Value with{AwayId=e.Value?.ToString()})">@foreach(var club in FixtureCatalog.Clubs){<option value="@club.Id" disabled="@(club.Id==Value.HomeId)">@club.Name</option>}</select></label>
        </div>
        <div class="fixture-preview" aria-live="polite">
            @foreach(var id in new[]{Value.HomeId,Value.AwayId})
            {var club=FixtureCatalog.Clubs.Single(t=>t.Id==id);<div><img src="@club.Crest" alt="" /><strong>@club.Name</strong></div>}
        </div>
        <p class="caption">Home and away must differ. Selected catalog identities are frozen for this generation.</p>
    }
    else{<p class="caption">Random chooses from the existing six-club rotation only when you press Create. No history is changed by previewing this option.</p>}
    @if(Error is not null){<p class="error" role="alert">@Error</p>}
    <div class="actions"><button id="fixture-create" class="button purple" disabled="@Busy" @onclick="Create">Create match · Uses Copilot usage</button><button id="fixture-cancel" class="button" disabled="@Busy" @onclick="Cancel">Cancel</button></div>
</section>
@code{
    [Parameter] public FixtureChoice Value{get;set;}=new();
    [Parameter] public bool Busy{get;set;}
    [Parameter] public string? Error{get;set;}
    [Parameter] public EventCallback<FixtureChoice> Changed{get;set;}
    [Parameter] public EventCallback Create{get;set;}
    [Parameter] public EventCallback Cancel{get;set;}
}
